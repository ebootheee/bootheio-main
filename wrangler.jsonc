{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "bootheio-main",
	"compatibility_date": "2026-03-29",
	"compatibility_flags": ["nodejs_compat"],
	// Astro's sessions feature (auto-enabled by @astrojs/cloudflare) binds a KV
	// namespace named SESSION. Reusing the existing namespace; unused by the site
	// today but keeps the deploy config valid.
	"kv_namespaces": [
		{ "binding": "SESSION", "id": "3aa5e1fd60b740b5a7aced572b31a3da" }
	],
	"observability": {
		"enabled": true
	}
}
