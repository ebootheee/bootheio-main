{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"jsx": "preserve",
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"types": ["astro/client"]
	},
	"include": ["src/**/*"]
}
