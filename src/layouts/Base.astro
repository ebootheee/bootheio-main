---
import { getMenu, getEmDashCollection } from "emdash";
import {
	WidgetArea,
	EmDashHead,
	EmDashBodyStart,
	EmDashBodyEnd,
} from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import "../styles/theme.css";

interface Props {
	title: string;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	type?: "website" | "article";
	publishedTime?: string | null;
	modifiedTime?: string | null;
	author?: string | null;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
}

type MenuItem = {
	label: string;
	url: string;
	target?: string;
};

const {
	title,
	description,
	image,
	canonical,
	robots,
	type = "website",
	publishedTime,
	modifiedTime,
	author,
	content,
} = Astro.props;
const siteTitle = "boothe.io";
// If title already includes site title (from getSeoMeta), use as-is
const fullTitle = title.includes(siteTitle) ? title : `${title} - ${siteTitle}`;

const menu = await getMenu("primary");
const menuItems: MenuItem[] = (menu?.items as MenuItem[]) ?? [];

// Fetch pages for footer
const { entries: pages } = await getEmDashCollection("pages");

// Build public page context for plugin contributions
// SEO data is passed here and rendered securely by EmDashHead
const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: type,
	title: fullTitle,
	description,
	canonical,
	image,
	content,
	seo: { ogImage: image, robots },
	articleMeta: { publishedTime, modifiedTime, author },
	siteName: siteTitle,
});

// Check if user is logged in (for showing admin link)
const isLoggedIn = !!Astro.locals.user;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/png" sizes="512x512" href="/favicon-512.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="theme-color" content="#f5f7f1" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Instrument+Serif:ital@0;1&family=Source+Serif+4:ital,opsz,wght@0,8..60,400..700;1,8..60,400..700&family=VT323&display=swap"
			rel="stylesheet"
		/>
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
		<script is:inline>
			// Apply theme immediately to prevent flash.
			(function () {
				var cookieTheme = document.cookie
					.split("; ")
					.find(function (row) {
						return row.indexOf("theme=") === 0;
					});
				var localTheme = null;
				try {
					localTheme = localStorage.getItem("theme");
				} catch (e) {}
				var storedTheme = cookieTheme
					? decodeURIComponent(cookieTheme.split("=")[1])
					: localTheme;
				var theme =
					storedTheme === "light" || storedTheme === "dark"
						? storedTheme
						: "system";
				var prefersDark = window.matchMedia(
					"(prefers-color-scheme: dark)"
				).matches;
				var resolvedTheme =
					theme === "system" ? (prefersDark ? "dark" : "light") : theme;
				document.documentElement.classList.add(resolvedTheme);
				document.documentElement.dataset.theme = theme;
				document.documentElement.dataset.resolvedTheme = resolvedTheme;
			})();
		</script>
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<header class="site-header">
			<nav class="nav">
				<a href="/" class="site-title">
					<img src="/apple-touch-icon.png" alt="" width="28" height="28" class="site-title-mark" />
					{siteTitle}
					<span class="site-title-divider hide-mobile"></span>
					<span class="site-title-era hide-mobile">est. 2025</span>
				</a>
				<div class="nav-right">
					<!-- search removed -->
					<div class="nav-links">
						{
							menuItems.map((item) => (
								<a href={item.url} target={item.target}>
									{item.label}
								</a>
							))
						}
					</div>
					<a href="https://github.com/ebootheee" target="_blank" rel="noopener noreferrer" class="nav-github" aria-label="GitHub">
						<svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
					</a>
					<div class="theme-switcher" role="group" aria-label="Color theme">
						<button
							type="button"
							class="theme-btn"
							data-theme="light"
							aria-label="Use light theme"
							title="Light theme"
						>
							<svg
								width="16"
								height="16"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
								><circle cx="12" cy="12" r="5"></circle><line
									x1="12"
									y1="1"
									x2="12"
									y2="3"></line><line x1="12" y1="21" x2="12" y2="23"
								></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"
								></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"
								></line><line x1="1" y1="12" x2="3" y2="12"></line><line
									x1="21"
									y1="12"
									x2="23"
									y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"
								></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"
								></line></svg
							>
						</button>
						<button
							type="button"
							class="theme-btn"
							data-theme="dark"
							aria-label="Use dark theme"
							title="Dark theme"
						>
							<svg
								width="16"
								height="16"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
								><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"
								></path></svg
							>
						</button>
						<button
							type="button"
							class="theme-btn"
							data-theme="system"
							aria-label="Use system theme"
							title="System theme"
						>
							<svg
								width="16"
								height="16"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
								><rect x="2" y="3" width="20" height="14" rx="2" ry="2"
								></rect><line x1="8" y1="21" x2="16" y2="21"></line><line
									x1="12"
									y1="17"
									x2="12"
									y2="21"></line></svg
							>
						</button>
					</div>
					{
						isLoggedIn && (
							<a href="/_emdash/admin" class="nav-admin">
								Admin
							</a>
						)
					}
				</div>
			</nav>
		</header>

		<main>
			<slot />
		</main>

		<footer class="site-footer">
			<!-- Webring -->
			<div class="webring">
				<a href="#">&lt;&lt; prev</a>
				<span class="webring-sep">|</span>
				<span class="webring-label">~ indie web ring ~</span>
				<span class="webring-sep">|</span>
				<a href="#">next &gt;&gt;</a>
			</div>
			<div class="footer-inner">
				<div class="footer-grid">
					<div class="footer-brand">
						<a href="/" class="footer-logo">{siteTitle}</a>
						<p class="footer-tagline">Technical writing, engineering projects, and 3D prints.</p>
						<!-- Visitor counter -->
						<div class="visitor-counter">
							<span class="visitor-counter-label">Visitors</span>
							<span id="visitor-counter" class="visitor-counter-digits"></span>
						</div>
					</div>
					<div class="footer-nav">
						<h4 class="footer-heading">Navigate</h4>
						<ul class="footer-links">
							<li><a href="/">Home</a></li>
							<li><a href="/posts">All Posts</a></li>
							{
								pages.slice(0, 3).map((page) => (
									<li>
										<a href={`/pages/${page.data.slug || page.id}`}>
											{page.data.title}
										</a>
									</li>
								))
							}
						</ul>
					</div>
					<div class="footer-nav">
						<h4 class="footer-heading">Connect</h4>
						<ul class="footer-links">
							{
								menuItems.map((item) => (
									<li>
										<a
											href={item.url}
											target={item.target}
											rel={
												item.target === "_blank"
													? "noopener noreferrer"
													: undefined
											}
										>
											{item.label}
										</a>
									</li>
								))
							}
							<li><a href="https://github.com/ebootheee" target="_blank" rel="noopener noreferrer">GitHub</a></li>
							<li><a href="/rss.xml">RSS Feed</a></li>
						</ul>
					</div>
					<div class="footer-widgets-section">
						<WidgetArea name="footer" />
					</div>
				</div>
				<div class="footer-bottom">
					<p class="footer-copyright">
						Powered by <a href="https://emdashcms.com">EmDash</a>
					</p>
					<div class="footer-badges">
						<span class="footer-badge footer-badge-retro">
							best viewed in<br/><span>Netscape Navigator 4.0</span>
						</span>
						<span class="footer-badge footer-badge-valid">
							<span class="footer-badge-dot glow-pulse"></span>
							HTML 5.0 valid
						</span>
					</div>
				</div>
			</div>
		</footer>

		<script>
			const themeBtns =
				document.querySelectorAll<HTMLButtonElement>(".theme-btn");
			const root = document.documentElement;
			const colorSchemeQuery = window.matchMedia("(prefers-color-scheme: dark)");
			const themeColorMeta = document.querySelector<HTMLMetaElement>(
				'meta[name="theme-color"]'
			);

			type ThemeChoice = "light" | "dark" | "system";

			function readCookie(name: string): string | null {
				return (
					document.cookie
						.split("; ")
						.find((row) => row.startsWith(`${name}=`))
						?.split("=")[1] ?? null
				);
			}

			function setThemeCookie(value: ThemeChoice | "") {
				const secure = location.protocol === "https:" ? "; Secure" : "";
				if (!value) {
					document.cookie = `theme=; path=/; max-age=0; SameSite=Lax${secure}`;
					return;
				}
				document.cookie = `theme=${encodeURIComponent(value)}; path=/; max-age=31536000; SameSite=Lax${secure}`;
			}

			function normalizeTheme(value: string | null | undefined): ThemeChoice {
				return value === "light" || value === "dark" ? value : "system";
			}

			function getStoredTheme(): ThemeChoice {
				let localTheme: string | null = null;
				try {
					localTheme = localStorage.getItem("theme");
				} catch {
					localTheme = null;
				}
				return normalizeTheme(
					readCookie("theme")
						? decodeURIComponent(readCookie("theme") as string)
						: localTheme
				);
			}

			function resolveTheme(theme: ThemeChoice): "light" | "dark" {
				return theme === "system"
					? colorSchemeQuery.matches
						? "dark"
						: "light"
					: theme;
			}

			function updateActiveBtn(theme: ThemeChoice, resolved: "light" | "dark") {
				themeBtns.forEach((btn) => {
					const isActive = btn.dataset.theme === theme;
					btn.classList.toggle("active", isActive);
					btn.setAttribute("aria-pressed", String(isActive));
					btn.dataset.resolvedTheme = resolved;
				});
			}

			function applyTheme(theme: ThemeChoice, persist = true) {
				const resolved = resolveTheme(theme);

				root.classList.remove("light", "dark");
				root.classList.add(resolved);
				root.dataset.theme = theme;
				root.dataset.resolvedTheme = resolved;

				if (themeColorMeta) {
					themeColorMeta.content = resolved === "dark" ? "#050508" : "#f5f7f1";
				}

				if (persist) {
					if (theme === "system") {
						try {
							localStorage.removeItem("theme");
						} catch {}
						setThemeCookie("");
					} else {
						try {
							localStorage.setItem("theme", theme);
						} catch {}
						setThemeCookie(theme);
					}
				}

				updateActiveBtn(theme, resolved);
			}

			applyTheme(getStoredTheme(), false);
			requestAnimationFrame(() => root.classList.add("theme-ready"));

			themeBtns.forEach((btn) => {
				btn.addEventListener("click", () => {
					applyTheme(normalizeTheme(btn.dataset.theme), true);
				});
			});

			colorSchemeQuery.addEventListener("change", () => {
				if (getStoredTheme() === "system") {
					applyTheme("system", false);
				}
			});
		</script>

		<style is:global>
			*:where(:not([class*="emdash"]):not([class*="ec-"])),
			*:where(:not([class*="emdash"]):not([class*="ec-"]))::before,
			*:where(:not([class*="emdash"]):not([class*="ec-"]))::after {
				box-sizing: border-box;
			}

			body,
			h1,
			h2,
			h3,
			h4,
			h5,
			h6,
			p,
			ul,
			ol,
			figure,
			blockquote,
			dl,
			dd {
				margin: 0;
			}

			ul,
			ol {
				padding: 0;
			}

			a:where(:not([class*="emdash"]):not([class*="ec-"])) {
				color: var(--color-accent);
				text-decoration: none;
				transition: color var(--transition-fast);
			}

			a:where(:not([class*="emdash"]):not([class*="ec-"])):hover {
				color: var(--color-accent-hover);
			}

			img {
				max-width: 100%;
				height: auto;
				display: block;
			}

			h1,
			h2,
			h3,
			h4,
			h5,
			h6 {
				font-family: var(--font-sans);
				line-height: var(--leading-tight);
				font-weight: 600;
				letter-spacing: var(--tracking-snug);
			}

			h1 {
				font-weight: 700;
				letter-spacing: var(--tracking-tight);
			}

			::selection {
				background: var(--color-accent-ring);
				color: var(--color-text);
			}
		</style>

		<style>
			.site-header {
				position: sticky;
				top: 0;
				z-index: 100;
				background: color-mix(in srgb, var(--color-bg) 82%, transparent);
				backdrop-filter: blur(12px);
				-webkit-backdrop-filter: blur(12px);
				border-bottom: 1px solid var(--color-border-subtle);
			}

			.nav {
				display: flex;
				justify-content: space-between;
				align-items: center;
				max-width: var(--wide-width);
				margin: 0 auto;
				padding: var(--spacing-4) var(--spacing-6);
				height: var(--nav-height);
			}

			.site-title {
				display: inline-flex;
				align-items: center;
				gap: 10px;
				font-family: var(--font-brand);
				font-style: italic;
				font-size: var(--font-size-lg);
				font-weight: 400;
				color: var(--color-text);
				text-decoration: none;
				letter-spacing: 0;
			}

			.site-title:hover {
				color: var(--color-accent);
			}

			.site-title-mark {
				display: block;
				border-radius: 50%;
				box-shadow: 0 0 0 1px var(--color-border);
			}

			.site-title-divider {
				display: inline-block;
				width: 1px;
				height: 16px;
				margin: 0 12px;
				background: var(--color-border);
				vertical-align: middle;
			}

			.site-title-era {
				color: var(--color-muted);
				font-family: var(--font-pixel);
				font-size: 0.7rem;
				font-style: normal;
			}

			.nav-right {
				display: flex;
				align-items: center;
				gap: var(--spacing-4);
			}

			.nav-links {
				display: flex;
				gap: var(--spacing-5);
				font-size: var(--font-size-sm);
				font-family: var(--font-mono);
			}

			.nav-links a {
				text-decoration: none;
				color: var(--color-text);
				transition: color var(--transition-fast);
			}

			.nav-links a:hover {
				color: var(--color-accent);
			}

			.nav-admin {
				font-size: var(--font-size-sm);
				color: var(--color-muted);
				text-decoration: none;
				opacity: 0.5;
				transition: opacity var(--transition-fast);
			}

			.nav-admin:hover {
				opacity: 1;
			}

			.nav-github {
				color: var(--color-muted);
				transition: color 0.2s ease;
				display: flex;
				align-items: center;
				justify-content: center;
				width: 32px;
				height: 32px;
			}

			.nav-github:hover {
				color: var(--color-accent);
			}

			.sparkle-container {
				position: fixed;
				inset: 0;
				pointer-events: none;
				z-index: 0;
			}

			.hide-mobile {}

			@media (max-width: 640px) {
				.hide-mobile { display: none !important; }
			}

			/* Search styling */
			.site-search {
				position: relative;
				width: var(--search-input-width);
				--emdash-search-border-focus: var(--color-accent);
			}

			:global(.site-search-input) {
				width: var(--search-input-width);
				padding: var(--spacing-2) var(--spacing-3);
				font-family: var(--font-mono);
				font-size: var(--font-size-sm);
				border: 1px solid var(--color-border);
				border-radius: var(--radius);
				background: var(--color-surface);
				color: var(--color-text);
				transition:
					border-color var(--transition-fast),
					box-shadow var(--transition-fast);
			}

			:global(.site-search-input)::placeholder {
				color: var(--color-muted);
			}

			:global(.site-search-input):focus,
			:global(.site-search-input):focus-visible {
				outline: none;
				border-color: var(--color-accent) !important;
				box-shadow: 0 0 0 3px var(--color-accent-ring);
			}

			:global(.site-search-results) {
				position: absolute;
				top: 100%;
				left: 0;
				right: 0;
				margin-top: var(--spacing-2);
				background: var(--color-surface);
				border: 1px solid var(--color-border);
				border-radius: var(--radius-lg);
				box-shadow: var(--shadow-dropdown);
				max-height: 400px;
				overflow-y: auto;
				z-index: 1000;
			}

			:global(.site-search-results .emdash-live-search-loading),
			:global(.site-search-results .emdash-live-search-no-results) {
				padding: var(--spacing-4);
				text-align: center;
				color: var(--color-muted);
				font-size: var(--font-size-sm);
			}

			:global(.site-search-result) {
				display: block;
				padding: var(--spacing-3) var(--spacing-4);
				text-decoration: none;
				color: var(--color-text);
				border-bottom: 1px solid var(--color-border-subtle);
				transition: background var(--transition-fast);
			}

			:global(.site-search-result):last-child {
				border-bottom: none;
			}

			:global(.site-search-result):hover,
			:global(.site-search-result):focus,
			:global(.site-search-result.focused) {
				background: var(--color-surface);
				outline: none;
			}

			:global(.site-search-result .emdash-live-search-result-title) {
				display: block;
				font-weight: 500;
				font-size: var(--font-size-sm);
			}

			:global(.site-search-result .emdash-live-search-result-collection) {
				display: block;
				font-size: var(--font-size-xs);
				color: var(--color-muted);
				text-transform: uppercase;
				letter-spacing: var(--tracking-wide);
				margin-top: 2px;
			}

			:global(.site-search-result .emdash-live-search-result-snippet) {
				display: block;
				font-size: var(--font-size-sm);
				color: var(--color-muted);
				margin-top: var(--spacing-1);
				line-height: var(--leading-snug);
			}

			:global(.site-search-result .emdash-live-search-result-snippet mark) {
				font-weight: 600;
				color: var(--color-text);
			}

			main {
				min-height: calc(100vh - var(--nav-height) - 300px);
			}

			/* Footer */
			.site-footer {
				background: var(--color-bg-subtle);
				border-top: 1px solid var(--color-border-subtle);
			}

			.webring {
				border-bottom: 1px dashed var(--color-retro-border);
				color: var(--color-retro-muted);
				font-family: var(--font-pixel);
				font-size: 0.75rem;
				padding: 10px 0;
				text-align: center;
			}

			.webring a {
				color: inherit;
				text-decoration: none;
			}

			.webring a:hover {
				color: var(--color-retro);
			}

			.webring-sep {
				margin: 0 8px;
				opacity: 0.35;
			}

			.webring-label {
				opacity: 0.85;
			}

			.footer-inner {
				max-width: var(--wide-width);
				margin: 0 auto;
				padding: var(--spacing-16) var(--spacing-6) var(--spacing-8);
			}

			.footer-grid {
				display: grid;
				grid-template-columns: 2fr 1fr 1fr 1fr;
				gap: var(--spacing-12);
				margin-bottom: var(--spacing-12);
			}

			.footer-brand {
				max-width: 280px;
			}

			.footer-logo {
				font-family: var(--font-brand);
				font-style: italic;
				font-size: var(--font-size-lg);
				font-weight: 400;
				color: var(--color-text);
				text-decoration: none;
				letter-spacing: 0;
			}

			.footer-tagline {
				margin-top: var(--spacing-3);
				font-size: var(--font-size-sm);
				color: var(--color-muted);
				line-height: var(--leading-relaxed);
			}

			.visitor-counter {
				display: flex;
				align-items: center;
				gap: 8px;
				margin-top: 16px;
			}

			.visitor-counter-label {
				color: var(--color-success-muted);
				font-family: var(--font-pixel);
				font-size: 0.7rem;
				letter-spacing: 0.1em;
				text-transform: uppercase;
			}

			.visitor-counter-digits {
				display: flex;
				gap: 2px;
			}

			.footer-nav {
				min-width: 0;
			}

			.footer-heading {
				font-size: var(--font-size-xs);
				font-weight: 500;
				text-transform: uppercase;
				letter-spacing: var(--tracking-wider);
				color: var(--color-muted);
				margin-bottom: var(--spacing-4);
			}

			.footer-links {
				list-style: none;
			}

			.footer-links li {
				margin-bottom: var(--spacing-2);
			}

			.footer-links a {
				color: var(--color-text-secondary);
				text-decoration: none;
				font-size: var(--font-size-sm);
				font-family: var(--font-mono);
				transition: color var(--transition-fast);
			}

			.footer-links a:hover {
				color: var(--color-text);
			}

			.footer-widgets-section :global(.widget-area) {
				display: block;
			}

			.footer-widgets-section :global(.widget) {
				color: var(--color-text-secondary);
			}

			.footer-widgets-section :global(.widget__title) {
				font-size: var(--font-size-xs);
				font-weight: 500;
				text-transform: uppercase;
				letter-spacing: var(--tracking-wider);
				color: var(--color-muted);
				margin-bottom: var(--spacing-4);
			}

			.footer-widgets-section :global(.widget__content) {
				color: var(--color-text-secondary);
				font-size: var(--font-size-sm);
				line-height: var(--leading-relaxed);
			}

			.footer-bottom {
				display: flex;
				justify-content: space-between;
				align-items: center;
				gap: var(--spacing-4);
				padding-top: var(--spacing-6);
				border-top: 1px solid var(--color-border);
			}

			.footer-copyright {
				font-size: var(--font-size-sm);
				color: var(--color-muted);
			}

			.footer-copyright a {
				color: var(--color-text-secondary);
			}

			.footer-badges {
				display: flex;
				align-items: center;
				gap: 8px;
			}

			.footer-badge {
				border-radius: var(--radius);
				font-family: var(--font-pixel);
				font-size: 0.6rem;
				line-height: 1.4;
				padding: 4px 10px;
			}

			.footer-badge-retro {
				border: 1px dashed var(--color-retro-border);
				color: var(--color-retro-muted);
				text-align: center;
			}

			.footer-badge-retro span {
				color: var(--color-retro);
			}

			.footer-badge-valid {
				display: flex;
				align-items: center;
				gap: 6px;
				border: 1px dashed var(--color-success-border);
				color: var(--color-success-muted);
			}

			.footer-badge-dot {
				width: 6px;
				height: 6px;
				border-radius: 50%;
				background: var(--color-success);
			}

			/* Theme switcher */
			.theme-switcher {
				display: flex;
				gap: var(--spacing-1);
				padding: var(--spacing-1);
				background: var(--color-panel);
				border: 1px solid var(--color-border);
				border-radius: var(--radius-lg);
			}

			.theme-btn {
				display: flex;
				align-items: center;
				justify-content: center;
				width: 32px;
				height: 28px;
				background: transparent;
				border: none;
				color: var(--color-muted);
				border-radius: var(--radius);
				cursor: pointer;
				transition:
					background var(--transition-fast),
					color var(--transition-fast),
					box-shadow var(--transition-fast);
			}

			.theme-btn:hover {
				color: var(--color-text);
				background: var(--color-accent-soft);
			}

			.theme-btn.active {
				background: var(--color-surface);
				color: var(--color-text);
				box-shadow: var(--shadow-btn-active);
			}

			.theme-btn:focus-visible {
				outline: 2px solid var(--color-accent);
				outline-offset: 2px;
			}

			.theme-btn svg {
				width: 16px;
				height: 16px;
			}

			@media (max-width: 900px) {
				.footer-grid {
					grid-template-columns: 1fr 1fr;
					gap: var(--spacing-8);
				}

				.footer-brand {
					grid-column: span 2;
					max-width: none;
				}
			}

			@media (max-width: 640px) {
				.site-header {
					position: relative;
					border-bottom: none;
				}

				.nav {
					flex-direction: row;
					flex-wrap: wrap;
					justify-content: space-between;
					align-items: center;
					height: auto;
					gap: var(--spacing-2);
					padding: var(--spacing-3) var(--spacing-4);
				}

				.site-title {
					font-size: var(--font-size-base);
				}

				.nav-right {
					display: contents;
				}

				.site-search {
					order: 0;
					max-width: 140px;
				}

				:global(.site-search-input) {
					width: 140px !important;
					padding: var(--spacing-1) var(--spacing-2) !important;
					font-size: var(--font-size-sm) !important;
				}

				.nav-links {
					order: 1;
					width: 100%;
					display: flex;
					column-gap: var(--spacing-3);
					row-gap: var(--spacing-1);
					flex-wrap: wrap;
					justify-content: flex-start;
				}

				.nav-github {
					order: 0;
				}

				.theme-switcher {
					order: 0;
					margin-left: auto;
				}

				.nav-admin {
					order: 2;
					position: absolute;
					right: var(--spacing-4);
					top: var(--spacing-3);
					font-size: var(--font-size-xs);
				}

				.footer-grid {
					grid-template-columns: 1fr;
				}

				.footer-brand {
					grid-column: span 1;
				}

				.footer-bottom {
					flex-direction: column;
					gap: var(--spacing-4);
					text-align: center;
				}

				.footer-badges {
					flex-wrap: wrap;
					justify-content: center;
				}
			}
		</style>

		<script>
			// Sparkles
			(function() {
				const chars = ['+', '*', '.'];
				const container = document.createElement('div');
				container.style.cssText = 'position:fixed;inset:0;pointer-events:none;z-index:0;overflow:hidden;';
				container.setAttribute('aria-hidden', 'true');
				for (let i = 0; i < 12; i++) {
					const s = document.createElement('span');
					s.textContent = chars[i % 3];
					s.className = 'sparkle';
					s.style.cssText = `position:absolute;top:${Math.random()*95}%;left:${Math.random()*95}%;font-size:${8+Math.random()*6}px;animation-duration:${2.5+Math.random()*2}s;animation-delay:${Math.random()*3}s;`;
					container.appendChild(s);
				}
				document.body.appendChild(container);
			})();

			// Visitor counter
			const counter = document.getElementById('visitor-counter');
			if (counter) {
				let count = parseInt(localStorage.getItem('visitor-count') || '0');
				if (count === 0) count = 13847 + Math.floor(Math.random() * 2000);
				count += Math.floor(Math.random() * 3) + 1;
				localStorage.setItem('visitor-count', count.toString());
				const digits = count.toString().padStart(6, '0').split('');
				counter.innerHTML = digits.map(d => `<span class="visitor-counter-digit">${d}</span>`).join('');
			}

			// Cmd+K / Ctrl+K to focus search
			document.addEventListener("keydown", (e) => {
				if ((e.metaKey || e.ctrlKey) && e.key === "k") {
					e.preventDefault();
					const searchInput = document.querySelector(
						".site-search-input"
					) as HTMLInputElement;
					if (searchInput) {
						searchInput.focus();
					}
				}
			});
		</script>
		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
