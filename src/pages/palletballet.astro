---
import Base from "../layouts/Base.astro";

// The physics runs in the browser now, so there is no hosted API to talk to.
// This is the base the in-game console prints its curl commands against: a
// local `docker compose up` of the public repo, which serves the identical
// engine. `?api=<url>` at runtime overrides it and switches the game back to
// HTTP against whatever you point it at.
const API_BASE = "http://localhost:8000";
const REPO_URL = "https://github.com/ebootheee/palletballet";

const failureFrames = [
	{ src: "/palletballet/topple-1.png", caption: "t = 0.0s — wheels engage" },
	{ src: "/palletballet/topple-2.png", caption: "t = 0.4s — top item shears" },
	{ src: "/palletballet/topple-3.png", caption: "t = 0.7s — load shift" },
	{ src: "/palletballet/topple-4.png", caption: "t = 1.1s — failed" },
];

const techStack = [
	{ name: "Python 3.12", flavor: "rt" },
	{ name: "MuJoCo 3.x", flavor: "rt" },
	{ name: "FastAPI", flavor: "rt" },
	{ name: "Pydantic v2", flavor: "rt" },
	{ name: "three.js", flavor: "rt" },
	{ name: "Astro", flavor: "build" },
	{ name: "uv", flavor: "build" },
	{ name: "Docker", flavor: "ops" },
	{ name: "Cloudflare Tunnel", flavor: "ops" },
	{ name: "GitHub Actions → GHCR", flavor: "ops" },
	{ name: "Watchtower", flavor: "ops" },
];
---

<Base
	title="PalletBallet"
	description="Dial a conveyor speed, send a pallet, watch the real MuJoCo replay — then see the envelope the solver would have set. Per-pallet physics inference, running in your browser."
	type="website"
>
	<!-- ============== HERO ============== -->
	<section class="pb-hero">
		<div class="pb-hero-inner">
			<p class="pb-status">
				<span class="pb-status-dot"></span>
				LIVE PHYSICS &nbsp;//&nbsp; <span id="pb-uptime">checking…</span>
			</p>

			<h1 class="pb-title">
				Pallet<span class="pb-title-italic">Ballet</span>
			</h1>

			<p class="pb-tagline">
				A pallet enters the conveyor zone. Geometry, mass, wrap, temperature, friction —
				all of it shoved through MuJoCo. Out the other side: the speed it can actually
				survive, the failure mode that would otherwise govern, and a replay of the moment
				it would have toppled. Below, you get the dials <em>before</em> the solver shows
				its answer. Beat it if you can.
			</p>

			<div class="pb-cta-row">
				<a href="#play" class="pb-btn pb-btn-primary">
					<span class="pb-btn-arrow">▾</span> Play — beat the solver
				</a>
				<a href="/posts/launching-palletballet" class="pb-btn">
					Read the deep-dive →
				</a>
				<a href={REPO_URL} target="_blank" rel="noopener noreferrer" class="pb-btn pb-btn-ghost">
					Source on GitHub →
				</a>
			</div>

			<div class="pb-hero-meta">
				<span class="pb-meta-item"><span class="pb-meta-k">repo</span> ebootheee/palletballet</span>
				<span class="pb-meta-sep">·</span>
				<span class="pb-meta-item"><span class="pb-meta-k">engine</span> mujoco · wasm · fp64</span>
				<span class="pb-meta-sep">·</span>
				<span class="pb-meta-item"><span class="pb-meta-k">stack</span> python · mujoco · fastapi · three.js</span>
			</div>
		</div>
	</section>

	<!-- ============== THE GAME ============== -->
	<section class="pb-section" id="play">
		<div class="pb-section-inner">
			<div class="pb-section-head">
				<span class="pb-section-label">// the game</span>
				<h2 class="pb-section-title">You set the belt. The physics decides.</h2>
			</div>

			<p class="pb-prose">
				Every dispatch is a live simulation: your dial settings go to the API, MuJoCo runs
				the conveyor profile against the actual pallet, and the 3D replay you watch is the
				solver's own trace — every box pose, every frame, straight from the physics engine.
				After the dust settles, the solver reveals the envelope it would have set.
				<strong>Score by shipping fast without shipping it onto the floor.</strong>
			</p>

			<div class="pbg" data-pallet-game data-api-base={API_BASE} data-phase="boot">
				<div class="pbg-topbar">
					<span class="pbg-status-text" data-pbg-status>waking the solver…</span>
					<span class="pbg-shift-tracker" data-pbg-shift-tracker hidden></span>
					<button class="pbg-shift-btn" data-pbg-shift type="button">▸ START SHIFT (5 pallets)</button>
				</div>

				<div class="pbg-chips" data-pbg-chips>
					<span class="pbg-chips-loading">loading scenarios…</span>
				</div>

				<div class="pbg-main">
					<div class="pbg-stage-wrap">
						<div class="pbg-canvas" data-pbg-canvas>
							<div class="pbg-canvas-placeholder">
								<span class="pbg-canvas-hint">3D stage loads when you scroll here</span>
							</div>
						</div>
						<div class="pbg-stamp" data-pbg-stamp hidden></div>
						<div class="pbg-hud">
							<span data-pbg-clock>t = 0.00 s</span>
							<span data-pbg-belt-vel>belt 0.00 m/s</span>
						</div>
						<div class="pbg-transport">
							<button class="pbg-tbtn" data-pbg-play type="button" title="Play / pause">▶</button>
							<input class="pbg-scrub" data-pbg-scrub type="range" min="0" max="1000" value="0" aria-label="Replay position" />
							<button class="pbg-tbtn pbg-tbtn-slomo" data-pbg-slomo type="button" title="Slow motion">¼×</button>
						</div>
					</div>

					<aside class="pbg-side">
						<div class="pbg-load-card">
							<div class="pbg-load-head">
								<span class="pbg-load-name" data-pbg-load-name>—</span>
								<span class="pbg-load-tag" data-pbg-load-tag></span>
							</div>
							<p class="pbg-load-desc" data-pbg-load-desc></p>
							<div class="pbg-load-stats" data-pbg-load-stats></div>
						</div>

						<div class="pbg-dials">
							<label class="pbg-dial">
								<span class="pbg-dial-label">belt speed <b data-pbg-speed-val>0.60 m/s</b></span>
								<input data-pbg-speed type="range" min="0.2" max="2.5" step="0.05" value="0.6" />
							</label>
							<label class="pbg-dial">
								<span class="pbg-dial-label">acceleration <b data-pbg-accel-val>1.0 m/s²</b></span>
								<input data-pbg-accel type="range" min="0.3" max="8" step="0.1" value="1.0" />
							</label>
							<button class="pbg-send" data-pbg-send type="button">
								<span class="pbg-send-idle">▸ SEND IT</span>
								<span class="pbg-send-busy">running mujoco…</span>
							</button>
						</div>

						<div class="pbg-reveal" data-pbg-reveal hidden>
							<div class="pbg-outcome-row">
								<span class="pbg-outcome" data-pbg-outcome></span>
								<span class="pbg-points" data-pbg-points>0 pts</span>
							</div>
							<span class="pbg-badge" data-pbg-badge hidden></span>
							<div class="pbg-envelope" data-pbg-envelope></div>
							<div class="pbg-reveal-actions">
								<button class="pbg-mini-btn" data-pbg-replay-again type="button">↺ watch again</button>
								<button class="pbg-mini-btn pbg-mini-primary" data-pbg-next type="button" hidden>NEXT PALLET →</button>
							</div>
						</div>
					</aside>
				</div>

				<div class="pbg-shift-report" data-pbg-shift-report hidden></div>
				<button class="pbg-share" data-pbg-share type="button" hidden>share shift report ⧉</button>

				<details class="pbg-console-wrap" open>
					<summary>Solver calls — every request the game makes, in the API's shape, copyable as curl</summary>
					<div class="pbg-console" data-pbg-console></div>
				</details>
			</div>

			<p class="pb-prose pb-prose-small pbg-footnote">
				No canned outcomes: the replay frames are MuJoCo's integrator output at 30 Hz, and
				the envelope reveal is a fresh bisection search (5–8 sims) per pallet. If the
				numbers feel conservative, read
				<a href="/posts/launching-palletballet">how the failure detectors work</a> — then
				argue with the physics.
			</p>
		</div>
	</section>

	<!-- ============== WHAT IS IT ============== -->
	<section class="pb-section pb-section-prose">
		<div class="pb-section-inner pb-narrow">
			<div class="pb-section-head">
				<span class="pb-section-label">// the why</span>
				<h2 class="pb-section-title">A static speed table is conservative on good pallets and blind to weird ones</h2>
			</div>

			<p class="pb-prose">
				Cold-storage warehouses move pallets across long conveyors at speeds set once,
				usually pessimistically, by a person guessing at the worst case. A perfectly
				stacked dairy pallet gets the same 1.0 m/s as a top-heavy unwrapped tower of
				frozen meat that <em>should</em> be capped at 0.4 m/s. The first is being throttled.
				The second is being launched.
			</p>

			<p class="pb-prose">
				PalletBallet skips the table. For each pallet — described by its actual geometry,
				mass distribution, wrap, and thermal state — it runs a small batch of physics
				simulations and answers a narrower question:
			</p>

			<blockquote class="pb-pullquote">
				Given <em>this</em> pallet, in <em>this</em> thermal state, what conveyor motion
				profile is safe right now?
			</blockquote>

			<p class="pb-prose">
				The result is per-pallet decisioning: speed, acceleration, deceleration, lateral
				g-tolerance, and the failure mode that would otherwise govern — slip, top-item
				slide, load shift, or tip-over. A PLC can throttle the next conveyor zone with
				it. A WMS can flag the pallet for re-wrap. A human can look at the replay and
				agree. You just did, above.
			</p>
		</div>
	</section>

	<!-- ============== FAILURE GALLERY ============== -->
	<section class="pb-section">
		<div class="pb-section-inner">
			<div class="pb-section-head">
				<span class="pb-section-label">// the dance</span>
				<h2 class="pb-section-title">Failures in slow motion</h2>
			</div>

			<p class="pb-prose">
				Trust comes from watching things go wrong. Here's a top-heavy unwrapped pallet
				hitting an aggressive start ramp. Every frame is from a real solver run, not a
				render — same physics, same engine, same trace the API returns to the game above.
			</p>

			<div class="pb-gallery">
				{failureFrames.map((f, i) => (
					<figure class="pb-frame">
						<img src={f.src} alt={f.caption} loading="lazy" width="800" height="500" />
						<figcaption>
							<span class="pb-frame-num">{String(i + 1).padStart(2, "0")}</span>
							{f.caption}
						</figcaption>
					</figure>
				))}
			</div>
		</div>
	</section>

	<!-- ============== HOW IT WORKS ============== -->
	<section class="pb-section">
		<div class="pb-section-inner pb-narrow">
			<div class="pb-section-head">
				<span class="pb-section-label">// the how</span>
				<h2 class="pb-section-title">Six stages, end to end</h2>
			</div>

			<ol class="pb-stages">
				<li>
					<span class="pb-stage-tag">01</span>
					<div>
						<h3>Inputs land in a single contract</h3>
						<p>Scanner output, WMS export, a manual stack builder, or the random adapter all converge on the same <code>RawInputs</code> Pydantic schema. The configurator turns it into a <code>PalletConfig</code> — items with positions, masses, fragility, wrap, temperature. The curated pallets you just played live at <code>GET /scenarios</code>.</p>
					</div>
				</li>
				<li>
					<span class="pb-stage-tag">02</span>
					<div>
						<h3>Friction is temperature-aware</h3>
						<p>Cold-chain pallets move through frost-melt regimes where mu drops by half. The friction model interpolates a calibration table and applies a transition penalty when the pallet is near 0 °C with recent thermal motion — the regime that actually causes slips on real lines.</p>
					</div>
				</li>
				<li>
					<span class="pb-stage-tag">03</span>
					<div>
						<h3>The MJCF builder emits MuJoCo XML</h3>
						<p>Each pallet becomes a free-body MJCF scene: base, items, contact pairs with the right friction coefficients, a velocity-actuated conveyor. Wrap becomes weld constraints with stiffness per wrap type. No GUI, no rendering — pure physics.</p>
					</div>
				</li>
				<li>
					<span class="pb-stage-tag">04</span>
					<div>
						<h3>The solver runs the conveyor profile</h3>
						<p>Acceleration ramp, target speed, dwell, deceleration. The trace records pallet pose, item poses, and belt state every step. Failure detectors look for tip angle past threshold, item slide in the pallet frame, pairwise load shift, and pallet-vs-belt slip. With <code>include_replay</code>, the API hands the whole 6-DoF pose history to your browser — that's what the 3D stage plays back.</p>
					</div>
				</li>
				<li>
					<span class="pb-stage-tag">05</span>
					<div>
						<h3>The threshold analyzer searches the boundary</h3>
						<p>A bisection search walks the speed and acceleration axes. Five to eight simulations later, you have a tight upper bound on each — the line between "survives" and "fails." Results are cached by config fingerprint, so duplicates cost nothing.</p>
					</div>
				</li>
				<li>
					<span class="pb-stage-tag">06</span>
					<div>
						<h3>FastAPI hands back a SafetyResult</h3>
						<p>Plus the sweep points, the dominant failure mode, the cache hit count, and a confidence score. That is the shape the API returns — run the repo and it is self-documented at <code>{API_BASE}/docs</code>. Cache hits return in ~1 ms.</p>
					</div>
				</li>
			</ol>
		</div>
	</section>

	<!-- ============== ARCHITECTURE ============== -->
	<section class="pb-section">
		<div class="pb-section-inner">
			<div class="pb-section-head">
				<span class="pb-section-label">// the wiring</span>
				<h2 class="pb-section-title">How this page actually serves you a physics result</h2>
				<p class="pb-section-note">It used to call a FastAPI service on a home server through a Cloudflare Tunnel. As of August 2026 the solver ships to you instead: the same MuJoCo build, at the same fp64 precision, compiled to WebAssembly and run in a worker thread in this tab. The API still exists in the repo — it is just no longer in the path.</p>
			</div>

			<pre class="pb-arch">
 your browser
 ┌──────────────────────────────────────────────┐
 │ boothe.io/palletballet                       │
 │  (Astro on Cloudflare Workers, static)       │
 │                                              │
 │   main thread          worker thread         │
 │  ┌──────────────┐     ┌────────────────────┐ │
 │  │ game UI      │────►│ @palletballet/     │ │
 │  │ three.js     │◄────│   engine           │ │
 │  └──────────────┘     │  ├── mujoco.wasm   │ │
 │                       │  │   (fp64, 2.5 MB)│ │
 │                       │  ├── solver        │ │
 │                       │  ├── detectors     │ │
 │                       │  └── envelope      │ │
 │                       │      search        │ │
 │                       └────────────────────┘ │
 └──────────────────────────────────────────────┘
       no network · no server · works offline

 the same engine, still packaged as a service:

       docker compose up  ──►  localhost:8000
                               ├── /solve
                               ├── /safety/analyze
                               └── /docs
                          ghcr.io/ebootheee/palletballet
</pre>
		</div>
	</section>

	<!-- ============== TECH STACK ============== -->
	<section class="pb-section">
		<div class="pb-section-inner">
			<div class="pb-section-head">
				<span class="pb-section-label">// the parts</span>
				<h2 class="pb-section-title">Stack</h2>
			</div>

			<div class="pb-chips">
				{techStack.map((t) => (
					<span class={`pb-chip pb-chip-${t.flavor}`}>{t.name}</span>
				))}
			</div>

			<p class="pb-prose pb-prose-small">
				Those numbers are from the Python service on a Ryzen 9 box: a single conveyor
				sim in 60–200 ms, a full envelope search in 400–800 ms, cache hits in ~1 ms,
				and ~7 pallets/second in batch mode across all cores. In your browser the same
				engine runs about 1.4–2.2× slower per step — typically a few hundred
				milliseconds for the search above, which is what the console is reporting.
			</p>
		</div>
	</section>

	<!-- ============== CTA ============== -->
	<section class="pb-section pb-cta-section">
		<div class="pb-section-inner pb-narrow">
			<div class="pb-cta-card">
				<div class="pb-cta-corner-tl">+~</div>
				<div class="pb-cta-corner-tr">~+</div>
				<h3 class="pb-cta-title">
					<span class="blink">&gt;</span> Read the source. Run your own.
				</h3>
				<p class="pb-cta-text">
					The code is open. The Dockerfile and tunnel config are in
					<code>infra/</code>. Cloning and running <code>docker compose up -d</code>
					gets you the same engine this page is running, with the HTTP API in front of it — and the
					<a href="/posts/launching-palletballet">launch post</a> walks through every
					endpoint, the batch runner, and the physics.
				</p>
				<div class="pb-cta-row pb-cta-row-center">
					<a href={REPO_URL} target="_blank" rel="noopener noreferrer" class="pb-btn pb-btn-primary">
						github.com/ebootheee/palletballet →
					</a>
					<a href="/posts/launching-palletballet#the-api-endpoint-by-endpoint" class="pb-btn">
						API walkthrough →
					</a>
				</div>
			</div>
		</div>
	</section>
</Base>

<script>
	import { initPalletGame } from "../components/pallet-game-client";
	initPalletGame();
</script>

<script is:inline>
	// There is no hosted API to probe any more — the solver runs in this tab.
	// The label is set here rather than in the markup so it only appears once
	// JS is alive, which is also the condition for the game working at all.
	(() => {
		const el = document.getElementById("pb-uptime");
		if (!el) return;
		el.textContent = "in this tab · no server";
		el.classList.add("pb-uptime-ok");
	})();
</script>

<style>
	/* =========================================================
	   Page-scoped styles. Inherit theme.css tokens for fonts,
	   palette, spacing. Page tokens are pb-*, game tokens pbg-*.
	   ========================================================= */

	.pb-hero {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: 5rem var(--spacing-6) 3rem;
		position: relative;
	}

	.pb-hero-inner { max-width: 880px; }

	.pb-status {
		font-family: var(--font-pixel);
		font-size: 0.875rem;
		color: var(--color-retro-muted);
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 1rem;
		letter-spacing: 0.04em;
	}
	.pb-status-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--color-success);
		animation: glow-pulse 3s ease-in-out infinite;
	}
	#pb-uptime { color: var(--color-retro-muted); }
	:global(.pb-uptime-ok) { color: var(--color-success) !important; }
	:global(.pb-uptime-warn) { color: var(--color-retro) !important; }
	:global(.pb-uptime-off) { color: var(--color-danger) !important; opacity: 0.8; }

	.pb-title {
		font-family: var(--font-serif) !important;
		font-size: 5.75rem;
		font-weight: 400 !important;
		line-height: 1;
		color: var(--color-text);
		margin-bottom: 1.5rem;
		letter-spacing: 0;
	}
	.pb-title-italic {
		font-style: italic;
		color: var(--color-accent);
	}

	.pb-tagline {
		font-family: var(--font-serif);
		font-size: 1.15rem;
		line-height: 1.55;
		color: var(--color-text-secondary);
		max-width: 720px;
		margin-bottom: 2rem;
	}
	.pb-tagline em {
		font-style: italic;
		color: var(--color-accent);
	}

	.pb-cta-row {
		display: flex;
		gap: 0.75rem;
		flex-wrap: wrap;
		margin-bottom: 2rem;
	}
	.pb-cta-row-center { justify-content: center; }

	.pb-btn {
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		padding: 0.65rem 1.1rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		color: var(--color-text);
		text-decoration: none;
		background: var(--color-panel);
		transition:
			border-color var(--transition-fast),
			background var(--transition-fast),
			color var(--transition-fast),
			transform var(--transition-fast);
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		letter-spacing: 0.01em;
	}
	.pb-btn:hover {
		border-color: var(--color-accent-border);
		background: var(--color-accent-soft);
		color: var(--color-accent-hover);
		transform: translateY(-1px);
	}
	.pb-btn-primary {
		background: var(--color-accent);
		color: var(--color-on-accent) !important;
		border-color: var(--color-accent);
		font-weight: 500;
	}
	.pb-btn-primary:hover {
		background: var(--color-accent-hover);
		border-color: var(--color-accent-hover);
		color: var(--color-on-accent) !important;
	}
	.pb-btn-ghost {
		background: transparent;
		color: var(--color-muted);
	}
	.pb-btn-ghost:hover {
		color: var(--color-text);
	}
	.pb-btn-arrow {
		display: inline-block;
		font-size: 0.7rem;
		opacity: 0.7;
	}

	.pb-hero-meta {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--color-muted);
		margin-top: 2rem;
		padding-top: 1.5rem;
		border-top: 1px dashed var(--color-border);
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.pb-meta-k {
		color: var(--color-retro-muted);
		font-family: var(--font-pixel);
		font-size: 0.85rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		margin-right: 0.4rem;
	}
	.pb-meta-sep {
		color: var(--color-border);
		opacity: 0.6;
	}

	/* ---- Generic sections ------------------------------------------------ */

	.pb-section {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: 4rem var(--spacing-6) 3rem;
	}
	.pb-section-inner { max-width: 100%; }
	.pb-narrow { max-width: 720px; margin: 0 auto; }

	.pb-section-head { margin-bottom: 1.75rem; }
	.pb-section-label {
		display: block;
		font-family: var(--font-pixel);
		font-size: 0.7rem;
		color: var(--color-retro-muted);
		text-transform: uppercase;
		letter-spacing: 0.18em;
		margin-bottom: 0.4rem;
	}
	.pb-section-title {
		font-family: var(--font-serif) !important;
		font-size: 2.25rem;
		font-weight: 400 !important;
		color: var(--color-text);
		line-height: 1.15;
	}

	/* Standfirst under a section title — used to explain the Aug 2026 move from
	   a hosted API to the in-browser engine. */
	.pb-section-note {
		font-family: var(--font-serif);
		font-size: 1.05rem;
		line-height: 1.7;
		color: var(--color-text-secondary);
		max-width: 62ch;
		margin-top: 0.9rem;
	}

	.pb-prose {
		font-family: var(--font-serif);
		font-size: 1.05rem;
		line-height: 1.75;
		color: var(--color-text-secondary);
		max-width: 680px;
		margin-bottom: 1.25rem;
	}
	.pb-prose em {
		font-style: italic;
		color: var(--color-text);
	}
	.pb-prose strong { color: var(--color-text); }
	.pb-prose a { color: var(--color-accent); }
	.pb-prose code {
		font-family: var(--font-mono);
		font-size: 0.85em;
		background: var(--color-surface);
		color: var(--color-accent);
		padding: 0.1em 0.35em;
		border-radius: 3px;
		border: 1px solid var(--color-border);
	}
	.pb-prose-small { font-size: 0.95rem; }
	.pbg-footnote { margin-top: 1.25rem; }

	.pb-pullquote {
		font-family: var(--font-serif);
		font-size: 1.4rem;
		font-style: italic;
		line-height: 1.45;
		color: var(--color-text);
		border-left: 2px solid var(--color-accent-border);
		padding-left: 1.25rem;
		margin: 2rem 0;
		max-width: 640px;
	}
	.pb-pullquote em {
		color: var(--color-accent);
	}

	/* ---- Game shell ------------------------------------------------------ */

	.pbg {
		/* The stage is a control room: always dark, in both site themes. Pin
		   the theme tokens locally so light mode doesn't put near-black text
		   on the dark shell. */
		--color-text: #e6e9ec;
		--color-text-secondary: #b9c0c7;
		--color-muted: #828b94;
		--color-border: #22303a;
		--color-panel: rgba(16, 21, 26, 0.7);
		--color-surface: #10151a;
		--color-accent: #22d3ee;
		--color-accent-hover: #67e8f9;
		--color-accent-soft: rgba(34, 211, 238, 0.1);
		--color-accent-border: rgba(34, 211, 238, 0.35);
		--color-on-accent: #052a31;
		--color-success: #4ade80;
		--color-success-soft: rgba(74, 222, 128, 0.08);
		--color-success-border: rgba(74, 222, 128, 0.3);
		--color-danger: #f87171;
		--color-retro: #f59e0b;
		--color-retro-muted: rgba(245, 158, 11, 0.75);
		--color-retro-border: rgba(245, 158, 11, 0.35);
		--color-terminal-bar: #0d1216;

		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		background: var(--color-terminal-bg);
		overflow: hidden;
		margin: 2rem 0 1rem;
		box-shadow:
			0 0 0 1px var(--color-accent-soft),
			var(--shadow-elevated);
	}

	/* Author display rules must not defeat the hidden attribute. */
	.pbg [hidden] { display: none !important; }

	.pbg-topbar {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding: 0.65rem 1rem;
		background: var(--color-terminal-bar);
		border-bottom: 1px solid var(--color-border);
	}
	.pbg-status-text {
		font-family: var(--font-pixel);
		font-size: 0.9rem;
		letter-spacing: 0.05em;
		color: var(--color-retro-muted);
	}
	:global(.pbg-status-ok) { color: var(--color-success) !important; }
	:global(.pbg-status-warn) { color: var(--color-retro) !important; }
	:global(.pbg-status-off) { color: var(--color-danger) !important; }

	.pbg-shift-btn {
		margin-left: auto;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.05em;
		padding: 0.45rem 0.9rem;
		background: transparent;
		color: var(--color-retro);
		border: 1px solid var(--color-retro-border, var(--color-border));
		border-radius: var(--radius);
		cursor: pointer;
		transition: background var(--transition-fast), color var(--transition-fast);
	}
	.pbg-shift-btn:hover:not(:disabled) {
		background: color-mix(in srgb, var(--color-retro) 12%, transparent);
	}
	.pbg-shift-btn:disabled { opacity: 0.6; cursor: default; }

	.pbg-shift-tracker {
		display: inline-flex;
		gap: 0.35rem;
		align-items: center;
	}
	.pbg-shift-tracker :global(.pbg-track) {
		font-family: var(--font-pixel);
		font-size: 0.85rem;
		width: 22px;
		height: 22px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border: 1px solid var(--color-border);
		border-radius: 4px;
		color: var(--color-muted);
	}
	.pbg-shift-tracker :global(.pbg-track.now) {
		border-color: var(--color-accent);
		color: var(--color-accent);
	}
	.pbg-shift-tracker :global(.pbg-track.done-ok) {
		border-color: var(--color-success-border);
		color: var(--color-success);
		background: var(--color-success-soft);
	}
	.pbg-shift-tracker :global(.pbg-track.done-bad) {
		border-color: var(--color-danger);
		color: var(--color-danger);
		background: color-mix(in srgb, var(--color-danger) 10%, transparent);
	}
	.pbg-shift-tracker :global(.pbg-track-score) {
		font-family: var(--font-pixel);
		font-size: 0.9rem;
		color: var(--color-retro);
		margin-left: 0.35rem;
	}

	/* ---- Scenario chips ---------------------------------------------------- */

	.pbg-chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		padding: 0.85rem 1rem;
		border-bottom: 1px solid var(--color-border);
	}
	.pbg-chips-loading {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--color-muted);
	}
	.pbg-chips :global(.pbg-chip) {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.1rem;
		font-family: var(--font-mono);
		padding: 0.45rem 0.75rem;
		background: var(--color-panel);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		cursor: pointer;
		transition: border-color var(--transition-fast), background var(--transition-fast);
		text-align: left;
	}
	.pbg-chips :global(.pbg-chip:hover) {
		border-color: var(--color-accent-border);
	}
	.pbg-chips :global(.pbg-chip.active) {
		border-color: var(--color-accent);
		background: var(--color-accent-soft);
	}
	.pbg-chips :global(.pbg-chip-name) {
		font-size: 0.78rem;
		color: var(--color-text);
		font-weight: 600;
	}
	.pbg-chips :global(.pbg-chip.active .pbg-chip-name) { color: var(--color-accent); }
	.pbg-chips :global(.pbg-chip-sub) {
		font-size: 0.68rem;
		color: var(--color-muted);
	}

	/* ---- Stage + side panel ------------------------------------------------ */

	.pbg-main {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 340px;
	}

	.pbg-stage-wrap {
		position: relative;
		border-right: 1px solid var(--color-border);
		display: flex;
		flex-direction: column;
	}

	.pbg-canvas {
		position: relative;
		width: 100%;
		aspect-ratio: 16 / 10;
		min-height: 340px;
		background:
			radial-gradient(ellipse at 50% 80%, rgba(34, 211, 238, 0.06), transparent 65%),
			#06090b;
		overflow: hidden;
		touch-action: none;
	}
	.pbg-canvas :global(canvas) {
		position: absolute;
		inset: 0;
		width: 100% !important;
		height: 100% !important;
		display: block;
	}
	.pbg-canvas-placeholder {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.pbg-stage-ready .pbg-canvas-placeholder { display: none; }
	.pbg-canvas-hint {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--color-muted);
	}

	.pbg-stamp {
		position: absolute;
		top: 18%;
		left: 50%;
		transform: translateX(-50%) rotate(-4deg);
		max-width: 94%;
		text-align: center;
		font-family: var(--font-pixel);
		font-size: clamp(1.15rem, 3.6vw, 2.6rem);
		letter-spacing: 0.1em;
		color: #ff5c57;
		border: 3px solid #ff5c57;
		padding: 0.15em 0.5em;
		border-radius: 6px;
		background: rgba(6, 9, 11, 0.72);
		text-shadow: 0 0 18px rgba(255, 92, 87, 0.6);
		pointer-events: none;
		animation: pbg-stamp-in 260ms cubic-bezier(0.2, 1.6, 0.4, 1);
	}
	@keyframes pbg-stamp-in {
		from { transform: translateX(-50%) rotate(-4deg) scale(2.4); opacity: 0; }
		to   { transform: translateX(-50%) rotate(-4deg) scale(1); opacity: 1; }
	}
	:global(.pbg-crashing) .pbg-canvas {
		animation: pbg-shake 0.5s linear;
	}
	@keyframes pbg-shake {
		0%, 100% { transform: translate(0, 0); }
		20% { transform: translate(-4px, 2px); }
		40% { transform: translate(4px, -2px); }
		60% { transform: translate(-3px, -2px); }
		80% { transform: translate(3px, 2px); }
	}
	@media (prefers-reduced-motion: reduce) {
		:global(.pbg-crashing) .pbg-canvas { animation: none; }
		.pbg-stamp { animation: none; }
	}

	.pbg-hud {
		position: absolute;
		top: 0.7rem;
		left: 0.9rem;
		display: flex;
		gap: 1rem;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: rgba(228, 244, 250, 0.75);
		pointer-events: none;
	}

	.pbg-transport {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.55rem 0.9rem;
		background: var(--color-terminal-bar);
		border-top: 1px solid var(--color-border);
	}
	.pbg-tbtn {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		width: 34px;
		height: 28px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		background: transparent;
		color: var(--color-text-secondary);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		cursor: pointer;
		transition: color var(--transition-fast), border-color var(--transition-fast);
	}
	.pbg-tbtn:hover { color: var(--color-accent); border-color: var(--color-accent-border); }
	.pbg-tbtn-slomo { width: auto; padding: 0 0.5rem; }
	.pbg-tbtn-slomo.active { color: var(--color-retro); border-color: var(--color-retro); }
	.pbg-scrub {
		flex: 1;
		accent-color: var(--color-accent);
		min-width: 0;
	}

	/* ---- Side panel ---------------------------------------------------- */

	.pbg-side {
		display: flex;
		flex-direction: column;
		gap: 0;
		background: color-mix(in srgb, var(--color-terminal-bar) 60%, transparent);
	}

	.pbg-load-card {
		padding: 1rem 1.1rem 0.9rem;
		border-bottom: 1px dashed var(--color-border);
	}
	.pbg-load-head {
		display: flex;
		align-items: baseline;
		gap: 0.6rem;
		flex-wrap: wrap;
		margin-bottom: 0.35rem;
	}
	.pbg-load-name {
		font-family: var(--font-serif);
		font-size: 1.15rem;
		color: var(--color-text);
	}
	.pbg-load-tag {
		font-family: var(--font-pixel);
		font-size: 0.75rem;
		color: var(--color-retro-muted);
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.pbg-load-desc {
		font-family: var(--font-serif);
		font-size: 0.86rem;
		line-height: 1.5;
		color: var(--color-text-secondary);
		margin: 0 0 0.7rem;
	}
	.pbg-load-stats {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem 0.9rem;
		font-family: var(--font-mono);
		font-size: 0.7rem;
		color: var(--color-muted);
	}
	.pbg-load-stats :global(b) { color: var(--color-accent); font-weight: 600; }

	.pbg-dials {
		padding: 1rem 1.1rem;
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
		border-bottom: 1px dashed var(--color-border);
	}
	.pbg-dial { display: flex; flex-direction: column; gap: 0.3rem; }
	.pbg-dial-label {
		display: flex;
		justify-content: space-between;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--color-text-secondary);
		letter-spacing: 0.02em;
	}
	.pbg-dial-label b { color: var(--color-accent); font-weight: 600; }
	.pbg-dial input { accent-color: var(--color-accent); }

	.pbg-send {
		font-family: var(--font-mono);
		font-size: 0.95rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		padding: 0.8rem 1rem;
		background: var(--color-accent);
		color: var(--color-on-accent);
		border: none;
		border-radius: var(--radius);
		cursor: pointer;
		transition: background var(--transition-fast), transform var(--transition-fast);
	}
	.pbg-send:hover { background: var(--color-accent-hover); transform: translateY(-1px); }
	.pbg-send .pbg-send-busy { display: none; }
	.pbg[data-phase="simulating"] .pbg-send {
		pointer-events: none;
		animation: pbg-busy 1.1s ease-in-out infinite;
	}
	.pbg[data-phase="simulating"] .pbg-send .pbg-send-idle { display: none; }
	.pbg[data-phase="simulating"] .pbg-send .pbg-send-busy { display: inline; }
	.pbg[data-phase="replaying"] .pbg-send,
	.pbg[data-phase="boot"] .pbg-send,
	.pbg[data-phase="offline"] .pbg-send {
		pointer-events: none;
		opacity: 0.5;
	}
	@keyframes pbg-busy {
		0%, 100% { opacity: 1; }
		50% { opacity: 0.55; }
	}
	.pbg[data-phase="offline"] .pbg-dials,
	.pbg[data-phase="offline"] .pbg-chips { opacity: 0.45; pointer-events: none; }

	/* ---- Reveal ---------------------------------------------------------- */

	.pbg-reveal {
		padding: 1rem 1.1rem 1.2rem;
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}
	.pbg-outcome-row {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 0.6rem;
		font-family: var(--font-mono);
		font-size: 0.82rem;
		color: var(--color-text-secondary);
	}
	.pbg-points {
		font-family: var(--font-pixel);
		font-size: 1.3rem;
		color: var(--color-retro);
		white-space: nowrap;
	}
	:global(.pbg-ok) { color: var(--color-success); font-weight: 600; }
	:global(.pbg-bad) { color: var(--color-danger); font-weight: 600; }

	.pbg-badge {
		align-self: flex-start;
		font-family: var(--font-pixel);
		font-size: 0.85rem;
		letter-spacing: 0.12em;
		padding: 0.15rem 0.6rem;
		border-radius: 4px;
		border: 1px solid currentColor;
	}
	:global(.pbg-badge-ok) { color: var(--color-success); }
	:global(.pbg-badge-hot) { color: var(--color-retro); }
	:global(.pbg-badge-bad) { color: var(--color-danger); }

	.pbg-envelope {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		font-family: var(--font-mono);
		font-size: 0.74rem;
	}
	.pbg-envelope :global(.pbg-env-row) {
		display: grid;
		grid-template-columns: 1fr auto auto;
		gap: 0.6rem;
		align-items: baseline;
		color: var(--color-muted);
		padding: 0.2rem 0;
		border-bottom: 1px dotted color-mix(in srgb, var(--color-border) 60%, transparent);
	}
	.pbg-envelope :global(.pbg-env-row b) { color: var(--color-accent); font-weight: 600; }
	.pbg-envelope :global(.pbg-env-row i) {
		color: var(--color-text-secondary);
		font-style: normal;
		font-size: 0.68rem;
	}
	.pbg-envelope :global(.pbg-verdict) {
		font-family: var(--font-serif);
		font-style: italic;
		font-size: 0.9rem;
		line-height: 1.5;
		color: var(--color-text);
		margin: 0.5rem 0 0;
	}

	.pbg-reveal-actions {
		display: flex;
		gap: 0.5rem;
		margin-top: 0.4rem;
	}
	.pbg-mini-btn {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		padding: 0.4rem 0.7rem;
		background: transparent;
		color: var(--color-text-secondary);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		cursor: pointer;
		transition: color var(--transition-fast), border-color var(--transition-fast);
	}
	.pbg-mini-btn:hover { color: var(--color-accent); border-color: var(--color-accent-border); }
	.pbg-mini-primary {
		color: var(--color-on-accent);
		background: var(--color-accent);
		border-color: var(--color-accent);
		font-weight: 700;
	}
	.pbg-mini-primary:hover { color: var(--color-on-accent); background: var(--color-accent-hover); }

	/* ---- Shift report ------------------------------------------------------ */

	.pbg-shift-report {
		margin: 0 1rem 1rem;
		border: 1px dashed var(--color-retro-border, var(--color-border));
		border-radius: var(--radius-lg);
		padding: 1rem 1.2rem;
		font-family: var(--font-mono);
		font-size: 0.78rem;
		color: var(--color-text-secondary);
	}
	.pbg-shift-report :global(.pbg-report-head) {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-bottom: 0.8rem;
	}
	.pbg-shift-report :global(.pbg-report-grade) {
		font-family: var(--font-pixel);
		font-size: 3rem;
		line-height: 1;
		color: var(--color-retro);
	}
	.pbg-shift-report :global(.pbg-report-total) {
		font-family: var(--font-pixel);
		font-size: 1.1rem;
		color: var(--color-text);
	}
	.pbg-shift-report :global(.pbg-report-sub) { color: var(--color-muted); }
	.pbg-shift-report :global(.pbg-report-row) {
		display: grid;
		grid-template-columns: auto 1fr auto auto;
		gap: 0.7rem;
		padding: 0.3rem 0;
		border-top: 1px dotted color-mix(in srgb, var(--color-border) 60%, transparent);
		align-items: baseline;
	}
	.pbg-shift-report :global(.pbg-report-name) { color: var(--color-text); }
	.pbg-shift-report :global(.pbg-report-detail) { color: var(--color-muted); font-size: 0.7rem; }
	.pbg-shift-report :global(b) { color: var(--color-retro); }

	.pbg-share {
		margin: 0 1rem 1rem;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		padding: 0.5rem 0.9rem;
		background: transparent;
		color: var(--color-accent);
		border: 1px solid var(--color-accent-border);
		border-radius: var(--radius);
		cursor: pointer;
	}
	.pbg-share:hover { background: var(--color-accent-soft); }

	/* ---- API console ------------------------------------------------------- */

	.pbg-console-wrap {
		border-top: 1px solid var(--color-border);
		font-family: var(--font-mono);
		font-size: 0.75rem;
	}
	.pbg-console-wrap summary {
		cursor: pointer;
		padding: 0.6rem 1rem;
		color: var(--color-text-secondary);
		background: var(--color-terminal-bar);
		transition: color var(--transition-fast);
		list-style: none;
	}
	.pbg-console-wrap summary::before { content: "▸ "; color: var(--color-retro-muted); }
	.pbg-console-wrap[open] summary::before { content: "▾ "; }
	.pbg-console-wrap summary:hover { color: var(--color-accent); }
	.pbg-console {
		max-height: 240px;
		overflow-y: auto;
		padding: 0.5rem 1rem 0.8rem;
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
	}
	.pbg-console :global(.pbg-call) {
		display: grid;
		grid-template-columns: 3.2rem minmax(0, auto) 2.6rem auto 1fr auto;
		gap: 0.6rem;
		align-items: baseline;
		padding: 0.25rem 0;
		border-bottom: 1px dotted color-mix(in srgb, var(--color-border) 50%, transparent);
	}
	.pbg-console :global(.pbg-call-method) { color: var(--color-retro); font-weight: 600; }
	.pbg-console :global(.pbg-call-path) {
		color: var(--color-text);
