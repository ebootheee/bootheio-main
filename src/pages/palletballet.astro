---
import Base from "../layouts/Base.astro";

const API_BASE = "https://palletballet-api.boothe.io";
const REPO_URL = "https://github.com/ebootheee/palletballet";

const failureFrames = [
	{ src: "/palletballet/topple-1.png", caption: "t = 0.0s — wheels engage" },
	{ src: "/palletballet/topple-2.png", caption: "t = 0.4s — top item shears" },
	{ src: "/palletballet/topple-3.png", caption: "t = 0.7s — load shift" },
	{ src: "/palletballet/topple-4.png", caption: "t = 1.1s — failed" },
];

const techStack = [
	{ name: "Python 3.12", flavor: "rt" },
	{ name: "MuJoCo 3.x", flavor: "rt" },
	{ name: "FastAPI", flavor: "rt" },
	{ name: "Pydantic v2", flavor: "rt" },
	{ name: "uv", flavor: "build" },
	{ name: "Docker", flavor: "ops" },
	{ name: "Cloudflare Tunnel", flavor: "ops" },
	{ name: "GitHub Actions → GHCR", flavor: "ops" },
	{ name: "Watchtower", flavor: "ops" },
];
---

<Base
	title="PalletBallet"
	description="Per-pallet physics inference for cold-storage conveyors. A pallet enters; a safe speed envelope falls out — built on MuJoCo, served from a home server through Cloudflare Tunnel."
	type="website"
>
	<!-- ============== HERO ============== -->
	<section class="pb-hero">
		<div class="pb-hero-inner">
			<p class="pb-status">
				<span class="pb-status-dot"></span>
				LIVE DEMO &nbsp;//&nbsp; <span id="pb-uptime">checking…</span>
			</p>

			<h1 class="pb-title">
				Pallet<span class="pb-title-italic">Ballet</span>
			</h1>

			<p class="pb-tagline">
				A pallet enters the conveyor zone. Geometry, mass, wrap, temperature, friction —
				all of it shoved through MuJoCo. Out the other side: the speed it can actually
				survive, the failure mode that would otherwise govern, and a replay of the moment
				it would have toppled.
			</p>

			<div class="pb-cta-row">
				<a href="#demo" class="pb-btn pb-btn-primary">
					<span class="pb-btn-arrow">▾</span> Run the demo
				</a>
				<a href={REPO_URL} target="_blank" rel="noopener noreferrer" class="pb-btn">
					Source on GitHub →
				</a>
				<a href="/posts/launching-palletballet" class="pb-btn pb-btn-ghost">
					Read the launch post →
				</a>
			</div>

			<div class="pb-hero-meta">
				<span class="pb-meta-item"><span class="pb-meta-k">repo</span> ebootheee/palletballet</span>
				<span class="pb-meta-sep">·</span>
				<span class="pb-meta-item"><span class="pb-meta-k">api</span> palletballet-api.boothe.io</span>
				<span class="pb-meta-sep">·</span>
				<span class="pb-meta-item"><span class="pb-meta-k">stack</span> python · mujoco · fastapi</span>
			</div>
		</div>
	</section>

	<!-- ============== INTERACTIVE DEMO ============== -->
	<section class="pb-section" id="demo">
		<div class="pb-section-inner">
			<div class="pb-section-head">
				<span class="pb-section-label">// the demo</span>
				<h2 class="pb-section-title">Generate a pallet, see what it survives</h2>
			</div>

			<p class="pb-prose">
				Each click randomly configures a pallet — items, weights, wrap, temperature — and
				asks the live API to compute its safe operating envelope. The work is real: a
				MuJoCo simulation runs <em>several times</em> behind a Brent's-method search to
				find the failure boundary on each axis.
			</p>

			<div class="pb-terminal" id="pb-terminal">
				<div class="pb-terminal-bar">
					<span class="pb-tdot pb-tdot-r"></span>
					<span class="pb-tdot pb-tdot-y"></span>
					<span class="pb-tdot pb-tdot-g"></span>
					<span class="pb-terminal-title">palletballet — analyze</span>
					<span class="pb-terminal-hint" id="pb-hint">idle</span>
				</div>
				<pre class="pb-terminal-body" id="pb-out"><span class="pb-prompt">$</span> <span class="pb-faint">click "ANALYZE" to spawn a pallet and run the safety solver.</span>
<span class="pb-faint">  the solver runs 5–8 MuJoCo simulations under a brentq search.</span>
<span class="pb-faint">  expected wall time: ~400–800 ms.</span>
</pre>
				<div class="pb-terminal-controls">
					<button id="pb-run" class="pb-run-btn" type="button">
						<span class="pb-run-blink">▸</span> ANALYZE
					</button>
					<button id="pb-clear" class="pb-clear-btn" type="button">clear</button>
					<span class="pb-runs"><span id="pb-run-count">0</span> runs this session</span>
				</div>
			</div>

			<details class="pb-details">
				<summary>Where the data flows when you click that button</summary>
				<pre class="pb-flow">browser
  └─ POST <span class="pb-hl">{API_BASE}/pallet/random</span>
       └─ Cloudflare edge → Tunnel → home server → MockRandomAdapter → PalletConfig
  └─ POST <span class="pb-hl">{API_BASE}/safety/analyze</span>
       └─ ThresholdAnalyzer (brentq sweep on speed + accel)
            └─ MuJoCo solver × N runs → (mu, phi, w, ω) trace per run
                 └─ failure detector → FailureMode + tip angle
       └─ SafetyResult&#123; max_speed_mps, max_accel_mps2, governing_failure, ... &#125;
back to browser → rendered above
</pre>
			</details>
		</div>
	</section>

	<!-- ============== WHAT IS IT ============== -->
	<section class="pb-section pb-section-prose">
		<div class="pb-section-inner pb-narrow">
			<div class="pb-section-head">
				<span class="pb-section-label">// the why</span>
				<h2 class="pb-section-title">A static speed table is conservative on good pallets and blind to weird ones</h2>
			</div>

			<p class="pb-prose">
				Cold-storage warehouses move pallets across long conveyors at speeds set once,
				usually pessimistically, by a person guessing at the worst case. A perfectly
				stacked dairy pallet gets the same 1.0 m/s as a top-heavy unwrapped tower of
				frozen meat that <em>should</em> be capped at 0.4 m/s. The first is being throttled.
				The second is being launched.
			</p>

			<p class="pb-prose">
				PalletBallet skips the table. For each pallet — described by its actual geometry,
				mass distribution, wrap, and thermal state — it runs a small batch of physics
				simulations and answers a narrower question:
			</p>

			<blockquote class="pb-pullquote">
				Given <em>this</em> pallet, in <em>this</em> thermal state, what conveyor motion
				profile is safe right now?
			</blockquote>

			<p class="pb-prose">
				The result is per-pallet decisioning: speed, acceleration, deceleration, lateral
				g-tolerance, and the failure mode that would otherwise govern — slip, top-item
				slide, load shift, or tip-over. A PLC can throttle the next conveyor zone with
				it. A WMS can flag the pallet for re-wrap. A human can look at the replay and
				agree.
			</p>
		</div>
	</section>

	<!-- ============== FAILURE GALLERY ============== -->
	<section class="pb-section">
		<div class="pb-section-inner">
			<div class="pb-section-head">
				<span class="pb-section-label">// the dance</span>
				<h2 class="pb-section-title">Failures in slow motion</h2>
			</div>

			<p class="pb-prose">
				Trust comes from watching things go wrong. The UI ships with a rogues' gallery of
				known-bad scenarios; here's a top-heavy unwrapped pallet hitting an aggressive
				start ramp. Every frame is from a real solver run, not a render — same physics,
				same engine, same trace the API returns.
			</p>

			<div class="pb-gallery">
				{failureFrames.map((f, i) => (
					<figure class="pb-frame">
						<img src={f.src} alt={f.caption} loading="lazy" width="800" height="500" />
						<figcaption>
							<span class="pb-frame-num">{String(i + 1).padStart(2, "0")}</span>
							{f.caption}
						</figcaption>
					</figure>
				))}
			</div>
		</div>
	</section>

	<!-- ============== HOW IT WORKS ============== -->
	<section class="pb-section">
		<div class="pb-section-inner pb-narrow">
			<div class="pb-section-head">
				<span class="pb-section-label">// the how</span>
				<h2 class="pb-section-title">Six stages, end to end</h2>
			</div>

			<ol class="pb-stages">
				<li>
					<span class="pb-stage-tag">01</span>
					<div>
						<h3>Inputs land in a single contract</h3>
						<p>Scanner output, WMS export, a manual stack builder, or the random adapter all converge on the same <code>RawInputs</code> Pydantic schema. The configurator turns it into a <code>PalletConfig</code> — items with positions, masses, fragility, wrap, temperature.</p>
					</div>
				</li>
				<li>
					<span class="pb-stage-tag">02</span>
					<div>
						<h3>Friction is temperature-aware</h3>
						<p>Cold-chain pallets move through frost-melt regimes where mu drops by half. The friction model interpolates a calibration table and applies a transition penalty when the pallet is near 0 °C with recent thermal motion — the regime that actually causes slips on real lines.</p>
					</div>
				</li>
				<li>
					<span class="pb-stage-tag">03</span>
					<div>
						<h3>The MJCF builder emits MuJoCo XML</h3>
						<p>Each pallet becomes a 47-body MJCF: base, items, contact pairs with the right friction coefficients, a moving conveyor surface. No GUI, no rendering — pure physics.</p>
					</div>
				</li>
				<li>
					<span class="pb-stage-tag">04</span>
					<div>
						<h3>The solver runs the conveyor profile</h3>
						<p>Acceleration ramp, target speed, dwell, deceleration. The trace records pallet pose, item poses, and contact forces every step. Failure detectors look for tip angle past threshold, pairwise distance drift between items, and pallet-vs-belt slip.</p>
					</div>
				</li>
				<li>
					<span class="pb-stage-tag">05</span>
					<div>
						<h3>The threshold analyzer searches the boundary</h3>
						<p>A <code>brentq</code> root-finder walks the speed and acceleration axes. Five to eight simulations later, you have a tight upper bound on each — the line between "survives" and "fails." Results are cached by config fingerprint, so duplicates cost nothing.</p>
					</div>
				</li>
				<li>
					<span class="pb-stage-tag">06</span>
					<div>
						<h3>FastAPI hands back a SafetyResult</h3>
						<p>Plus the sweep points, the dominant failure mode, the cache hit count, and a confidence score. Available at <a href={`${API_BASE}/docs`} target="_blank" rel="noopener">{API_BASE}/docs</a>. Cache hits return in ~1 ms.</p>
					</div>
				</li>
			</ol>
		</div>
	</section>

	<!-- ============== ARCHITECTURE ============== -->
	<section class="pb-section">
		<div class="pb-section-inner">
			<div class="pb-section-head">
				<span class="pb-section-label">// the wiring</span>
				<h2 class="pb-section-title">How this page actually serves you a physics result</h2>
			</div>

			<pre class="pb-arch">
 your browser
       │
       ▼
 ┌─────────────────────┐         ┌───────────────────────────────┐
 │ boothe.io/          │         │ palletballet-api.boothe.io    │
 │ palletballet        │         │                               │
 │  (Astro on          │ fetch   │  ┌─────────────────────────┐  │
 │   Cloudflare        │────────►│  │ Cloudflare Tunnel       │  │
 │   Workers)          │  CORS   │  └─────────────┬───────────┘  │
 └─────────────────────┘         │                ▼              │
                                 │  ┌─────────────────────────┐  │
                                 │  │ home server (docker)    │  │
                                 │  │  ├── palletballet:8000  │  │
                                 │  │  ├── cloudflared        │  │
                                 │  │  └── watchtower         │  │
                                 │  └─────────────────────────┘  │
                                 └───────────────────────────────┘
                                            ▲
                                            │ pull on every push to main
                                            │
                                  ghcr.io/ebootheee/palletballet
                                            ▲
                                            │ build &amp; push
                                            │
                                       GitHub Actions
</pre>
		</div>
	</section>

	<!-- ============== TECH STACK ============== -->
	<section class="pb-section">
		<div class="pb-section-inner">
			<div class="pb-section-head">
				<span class="pb-section-label">// the parts</span>
				<h2 class="pb-section-title">Stack</h2>
			</div>

			<div class="pb-chips">
				{techStack.map((t) => (
					<span class={`pb-chip pb-chip-${t.flavor}`}>{t.name}</span>
				))}
			</div>

			<p class="pb-prose pb-prose-small">
				The whole runtime self-hosts on a Ryzen 1700X with 16 GB RAM. Cold start
				(API + MuJoCo) is ~3 seconds; a single safety analysis lands in 400–800 ms;
				cache hits return in ~1 ms. You're hitting that machine through a Cloudflare
				Tunnel right now.
			</p>
		</div>
	</section>

	<!-- ============== CTA ============== -->
	<section class="pb-section pb-cta-section">
		<div class="pb-section-inner pb-narrow">
			<div class="pb-cta-card">
				<div class="pb-cta-corner-tl">+~</div>
				<div class="pb-cta-corner-tr">~+</div>
				<h3 class="pb-cta-title">
					<span class="blink">&gt;</span> Read the source. Run your own.
				</h3>
				<p class="pb-cta-text">
					The code is open. The Dockerfile and tunnel config are in
					<code>infra/</code>. Cloning and running <code>docker compose up -d</code>
					gets you a working copy of the same system this page is talking to.
				</p>
				<div class="pb-cta-row pb-cta-row-center">
					<a href={REPO_URL} target="_blank" rel="noopener noreferrer" class="pb-btn pb-btn-primary">
						github.com/ebootheee/palletballet →
					</a>
					<a href={`${API_BASE}/docs`} target="_blank" rel="noopener noreferrer" class="pb-btn">
						Live API docs →
					</a>
				</div>
			</div>
		</div>
	</section>
</Base>

<script is:inline define:vars={{ API_BASE }}>
	// ---- Demo terminal driver ----------------------------------------------

	const out = document.getElementById("pb-out");
	const hint = document.getElementById("pb-hint");
	const runBtn = document.getElementById("pb-run");
	const clearBtn = document.getElementById("pb-clear");
	const runCount = document.getElementById("pb-run-count");
	const uptimeEl = document.getElementById("pb-uptime");

	let runs = 0;
	let busy = false;

	const FAILURE_LABELS = {
		no_failure: "NO FAILURE",
		tip_over: "TIP-OVER",
		top_item_slide: "TOP-ITEM SLIDE",
		pallet_slip: "PALLET SLIP",
		load_shift: "LOAD SHIFT",
	};

	function el(cls, text) {
		const span = document.createElement("span");
		if (cls) span.className = cls;
		span.textContent = text;
		return span;
	}
	function line(parts) {
		const frag = document.createDocumentFragment();
		parts.forEach((p) => frag.appendChild(p instanceof Node ? p : document.createTextNode(p)));
		frag.appendChild(document.createTextNode("\n"));
		out.appendChild(frag);
		out.scrollTop = out.scrollHeight;
	}
	const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

	async function streamLine(parts, delay = 60) {
		line(parts);
		await sleep(delay);
	}

	function ts(seconds) {
		return el("pb-ts", `[${seconds.toFixed(3)}s]`);
	}

	function clear() {
		out.innerHTML = "";
		line([el("pb-prompt", "$ "), el("pb-faint", 'click "ANALYZE" to run a fresh sim.')]);
	}

	clearBtn.addEventListener("click", () => {
		if (busy) return;
		clear();
	});

	runBtn.addEventListener("click", async () => {
		if (busy) return;
		busy = true;
		hint.textContent = "running…";
		runBtn.disabled = true;
		out.innerHTML = "";

		const start = performance.now();
		const dt = () => (performance.now() - start) / 1000;

		try {
			await streamLine([el("pb-prompt", "$ "), "./palletballet --random-pallet --analyze"]);
			await streamLine([ts(dt()), " spawning random pallet config…"]);

			const seed = Math.floor(Math.random() * 100000);
			const palletRes = await fetchWithTimeout(`${API_BASE}/pallet/random`, {
				method: "POST",
				headers: { "content-type": "application/json" },
				body: JSON.stringify({ seed, anomaly_rate: 0.25, min_layers: 2, max_layers: 5 }),
			});
			if (!palletRes.ok) throw new Error(`pallet/random ${palletRes.status}`);
			const pallet = await palletRes.json();

			await streamLine([
				ts(dt()),
				"   pallet_id  ",
				el("pb-val", pallet.pallet_id),
			]);
			await streamLine([
				ts(dt()),
				`   ${pallet.items.length} items · `,
				el("pb-val", `${pallet.total_mass_kg.toFixed(1)} kg`),
				` · stack `,
				el("pb-val", `${pallet.stack_height_m.toFixed(2)} m`),
				` · `,
				el("pb-val", `${pallet.body_temp_c.toFixed(1)}°C ${pallet.env}`),
				` · wrap=${pallet.wrap}`,
			]);

			await streamLine([ts(dt()), " building MJCF + running brentq sweep…"]);
			await streamLine([el("pb-faint", "             (5–8 mujoco sims, this is the real work)")]);

			const safetyRes = await fetchWithTimeout(`${API_BASE}/safety/analyze`, {
				method: "POST",
				headers: { "content-type": "application/json" },
				body: JSON.stringify(pallet),
			});
			if (!safetyRes.ok) throw new Error(`safety/analyze ${safetyRes.status}`);
			const safety = await safetyRes.json();
			const r = safety.result;

			await streamLine([ts(dt()), " ", el("pb-ok", "DONE")]);
			await streamLine([""]);

			const failureLabel = FAILURE_LABELS[r.dominant_failure_mode] ?? r.dominant_failure_mode;
			const failureClass = r.dominant_failure_mode === "no_failure" ? "pb-ok" : "pb-warn";

			line([el("pb-key", "  max_speed     "), el("pb-val", `${r.max_speed_mps.toFixed(2)} m/s`)]);
			line([el("pb-key", "  max_accel     "), el("pb-val", `${r.max_accel_mps2.toFixed(2)} m/s²`)]);
			line([el("pb-key", "  max_decel     "), el("pb-val", `${r.max_decel_mps2.toFixed(2)} m/s²`)]);
			line([el("pb-key", "  max_lateral_g "), el("pb-val", `${r.max_lateral_g.toFixed(2)} g`)]);
			line([el("pb-key", "  governing     "), el(failureClass, failureLabel)]);
			line([el("pb-key", "  margin        "), el("pb-val", `${r.margin_pct.toFixed(0)}%`)]);
			line([el("pb-key", "  confidence    "), el("pb-val", `${(r.confidence * 100).toFixed(0)}%`)]);
			line([
				el("pb-key", "  sims_run      "),
				el("pb-val", `${safety.sims_run}`),
				el("pb-faint", `   (cache hits: ${safety.cache_hits})`),
			]);
			line([el("pb-key", "  sim_runtime   "), el("pb-val", `${r.sim_runtime_ms.toFixed(0)} ms`)]);
			line([el("pb-key", "  config_hash   "), el("pb-faint", r.config_hash)]);

			runs += 1;
			runCount.textContent = String(runs);
			hint.textContent = `${(dt() * 1000).toFixed(0)} ms`;
		} catch (err) {
			await streamLine([el("pb-err", "ERROR: "), String(err.message ?? err)]);
			await streamLine([
				el("pb-faint", "the home server may be offline. showing a cached example…"),
			]);
			await sleep(400);
			renderCachedExample();
			hint.textContent = "offline → cached";
		} finally {
			busy = false;
			runBtn.disabled = false;
		}
	});

	function renderCachedExample() {
		line([el("pb-key", "  max_speed     "), el("pb-val", "1.42 m/s")]);
		line([el("pb-key", "  max_accel     "), el("pb-val", "5.80 m/s²")]);
		line([el("pb-key", "  max_decel     "), el("pb-val", "4.10 m/s²")]);
		line([el("pb-key", "  max_lateral_g "), el("pb-val", "0.32 g")]);
		line([el("pb-key", "  governing     "), el("pb-warn", "TOP-ITEM SLIDE")]);
		line([el("pb-key", "  margin        "), el("pb-val", "12%")]);
		line([el("pb-key", "  confidence    "), el("pb-val", "84%")]);
		line([el("pb-key", "  sims_run      "), el("pb-val", "7"), el("pb-faint", "   (cache hits: 0)")]);
		line([el("pb-key", "  sim_runtime   "), el("pb-val", "612 ms")]);
		line([el("pb-key", "  config_hash   "), el("pb-faint", "a4f1c3b2…")]);
	}

	async function fetchWithTimeout(url, opts, ms = 15000) {
		const controller = new AbortController();
		const t = setTimeout(() => controller.abort(), ms);
		return await fetch(url, { ...opts, signal: controller.signal }).finally(() =>
			clearTimeout(t),
		);
	}

	// ---- Uptime probe (best-effort, fails quietly to "offline") -----------

	(async () => {
		try {
			const t0 = performance.now();
			const r = await fetchWithTimeout(`${API_BASE}/healthz`, {}, 4000);
			const ms = Math.round(performance.now() - t0);
			if (r.ok) {
				uptimeEl.textContent = `online · ${ms}ms`;
				uptimeEl.classList.add("pb-uptime-ok");
			} else {
				uptimeEl.textContent = `degraded · http ${r.status}`;
				uptimeEl.classList.add("pb-uptime-warn");
			}
		} catch {
			uptimeEl.textContent = "offline";
			uptimeEl.classList.add("pb-uptime-off");
		}
	})();
</script>

<style>
	/* =========================================================
	   Page-scoped styles. Inherit theme.css tokens for fonts,
	   palette, spacing. Page-specific tokens are pb-* .
	   ========================================================= */

	.pb-hero {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: 5rem var(--spacing-6) 3rem;
		position: relative;
	}

	.pb-hero-inner { max-width: 880px; }

	.pb-status {
		font-family: var(--font-pixel);
		font-size: 0.875rem;
		color: var(--color-retro-muted);
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 1rem;
		letter-spacing: 0.04em;
	}
	.pb-status-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--color-success);
		animation: glow-pulse 3s ease-in-out infinite;
	}
	#pb-uptime { color: var(--color-retro-muted); }
	:global(.pb-uptime-ok) { color: var(--color-success) !important; }
	:global(.pb-uptime-warn) { color: var(--color-retro) !important; }
	:global(.pb-uptime-off) { color: var(--color-danger) !important; opacity: 0.8; }

