---
import { getEmDashCollection } from "emdash";
import Base from "../../layouts/Base.astro";

const { entries: models, cacheHint } = await getEmDashCollection("models", {
	status: "published",
	orderBy: { published_at: "desc" },
});

Astro.cache.set(cacheHint);

function getDescriptionExcerpt(description: unknown): string {
	if (!Array.isArray(description)) return "";
	const firstBlock = description.find((b: any) => b?._type === "block");
	if (!firstBlock) return "";
	const children = (firstBlock.children ?? []) as Array<{ text: string }>;
	return children.map((c) => c.text).join("").slice(0, 130);
}

const cards = models.map((model) => {
	const data = model.data as any;
	return {
		id: model.id,
		title: model.data.title,
		color: (data.color as string) || "#cfd1d4",
		material: (data.material as string) || "matte",
		excerpt: getDescriptionExcerpt(data.description),
	};
});
---

<Base title="Models" description="3D models and prints">
	<div class="models-page">
		<div class="page-header">
			<div class="breadcrumb">
				<a href="/">home</a>
				<span>/</span>
				<span class="current">models</span>
			</div>
			<h1 class="page-title">Models</h1>
			<p class="page-count">
				{models.length} model{models.length !== 1 ? "s" : ""} — 3D prints and designs
			</p>
			<div class="page-divider"></div>
		</div>

		{cards.length === 0 ? (
			<p class="empty">No models yet.</p>
		) : (
			<div class="models-grid">
				{cards.map((card) => (
					<a href={`/models/${card.id}`} class="model-card">
						<div class="model-swatch" style={`--swatch: ${card.color}`}>
							<span class="swatch-label">{card.material}</span>
						</div>
						<div class="model-card-body">
							<h2 class="model-card-title">{card.title}</h2>
							{card.excerpt && <p class="model-card-excerpt">{card.excerpt}</p>}
						</div>
					</a>
				))}
			</div>
		)}
	</div>
</Base>

<style>
	.models-page {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: 4rem var(--spacing-6);
	}

	.page-header {
		margin-bottom: 3rem;
	}

	.breadcrumb {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--color-muted);
		margin-bottom: 1rem;
	}

	.breadcrumb a {
		color: var(--color-muted);
		text-decoration: none;
		transition: color 0.2s;
	}

	.breadcrumb a:hover {
		color: var(--color-accent);
	}

	.breadcrumb .current {
		color: var(--color-text-secondary);
	}

	.page-title {
		font-family: var(--font-serif) !important;
		font-size: var(--font-size-4xl);
		font-weight: 400 !important;
		color: var(--color-text);
	}

	.page-count {
		margin-top: 0.75rem;
		font-size: 0.875rem;
		color: var(--color-muted);
	}

	.page-divider {
		margin-top: 1.5rem;
		height: 1px;
		background: var(--gradient-rule);
	}

	.models-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.25rem;
	}

	.empty {
		color: var(--color-muted);
		font-size: var(--font-size-lg);
	}

	.model-card {
		display: flex;
		flex-direction: column;
		border-radius: var(--radius-lg);
		border: 1px solid var(--color-border);
		background: var(--color-panel);
		text-decoration: none;
		color: inherit;
		overflow: hidden;
		transition:
			border-color 0.3s ease,
			background 0.3s ease,
			box-shadow 0.3s ease;
	}

	.model-card:hover {
		border-color: var(--color-accent-border);
		background: var(--color-panel-hover);
		box-shadow: var(--shadow-elevated);
	}

	.model-swatch {
		position: relative;
		height: 72px;
		background-color: var(--swatch, #cfd1d4);
		flex-shrink: 0;
	}

	.swatch-label {
		position: absolute;
		bottom: 8px;
		right: 10px;
		font-family: var(--font-mono);
		font-size: 0.6rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		background: rgba(0, 0, 0, 0.45);
		color: #fff;
		padding: 2px 7px;
		border-radius: 999px;
		backdrop-filter: blur(4px);
	}

	.model-card-body {
		padding: 1rem 1.25rem 1.25rem;
	}

	.model-card-title {
		font-family: var(--font-serif) !important;
		font-size: var(--font-size-lg);
		font-weight: 400 !important;
		color: var(--color-text);
		line-height: var(--leading-snug);
		margin-bottom: 0.375rem;
		transition: color 0.2s ease;
	}

	.model-card:hover .model-card-title {
		color: var(--color-accent);
	}

	.model-card-excerpt {
		font-size: var(--font-size-sm);
		line-height: var(--leading-relaxed);
		color: var(--color-muted);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		margin: 0;
	}

	@media (max-width: 900px) {
		.models-grid { grid-template-columns: repeat(2, 1fr); }
	}

	@media (max-width: 600px) {
		.models-page { padding: 2.5rem var(--spacing-4); }
		.page-title { font-size: var(--font-size-3xl); }
		.models-grid { grid-template-columns: 1fr; }
	}
</style>
