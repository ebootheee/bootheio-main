---
import { getCollection, render } from "astro:content";
import StlViewer from "../../components/StlViewer.astro";
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import { getReadingTime } from "../../utils/reading-time";

export const prerender = true;

export async function getStaticPaths() {
	const models = await getCollection("models");
	return models.map((model) => ({ params: { slug: model.id }, props: { model } }));
}

const { model } = Astro.props;
const { Content } = await render(model);
const d = model.data;

const modelUrl = d.model_url || "";
const material = d.material || "matte";
const color = d.color || "#cfd1d4";
const height = d.height || "tall";
const autoRotate = d.auto_rotate !== false;
const showGrid = d.show_grid !== false;

const allPosts = await getCollection("posts", (p) => !p.data.draft);
const relatedPosts = (d.related_posts ?? [])
	.map((s) => allPosts.find((p) => p.id === s))
	.filter((p): p is (typeof allPosts)[number] => Boolean(p));

const siteUrl = Astro.site?.origin ?? Astro.url.origin;

const publishDate =
	d.publishedAt?.toLocaleDateString("en-US", {
		year: "numeric",
		month: "long",
		day: "numeric",
	}) ?? null;
---

<Base
	title={d.title}
	description={d.title}
	canonical={`${siteUrl}/models/${model.id}`}
>
	<article class="model-page">
		<header class="model-header">
			<div class="breadcrumb">
				<a href="/">home</a>
				<span>/</span>
				<a href="/models">models</a>
				<span>/</span>
				<span class="current">{model.id}</span>
			</div>
			<h1 class="model-title">{d.title}</h1>
			<div class="model-meta">
				<span class="meta-chip" style={`--chip-color: ${color}`}>
					<span class="chip-dot"></span>
					{material}
				</span>
				{publishDate && <time class="meta-date">{publishDate}</time>}
			</div>
		</header>

		{modelUrl && (
			<div class="model-viewer">
				<StlViewer
					node={{
						id: modelUrl,
						material,
						color,
						height,
						autoRotate,
						showGrid,
					}}
				/>
			</div>
		)}

		<div class="model-description">
			<Content />
		</div>

		{relatedPosts.length > 0 && (
			<section class="related-posts">
				<h2 class="related-title">Featured in</h2>
				<div class="related-grid">
					{relatedPosts.map((post) => (
						<PostCard
							title={post.data.title}
							excerpt={post.data.excerpt}
							href={`/posts/${post.id}`}
							date={post.data.publishedAt ?? undefined}
							readingTime={getReadingTime(post.body)}
						/>
					))}
				</div>
			</section>
		)}
	</article>
</Base>

<style>
	.model-page {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: 3rem var(--spacing-6) var(--spacing-16);
	}

	.model-header {
		max-width: var(--content-width);
		margin: 0 auto var(--spacing-8);
	}

	.breadcrumb {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--color-muted);
		margin-bottom: var(--spacing-4);
	}

	.breadcrumb a {
		color: var(--color-muted);
		text-decoration: none;
		transition: color 0.2s;
	}

	.breadcrumb a:hover {
		color: var(--color-accent);
	}

	.breadcrumb .current {
		color: var(--color-text-secondary);
	}

	.model-title {
		font-family: var(--font-serif) !important;
		font-size: var(--font-size-4xl);
		font-weight: 400 !important;
		line-height: var(--leading-tight);
		letter-spacing: var(--tracking-tight);
		margin-bottom: var(--spacing-3);
	}

	.model-meta {
		display: flex;
		align-items: center;
		gap: var(--spacing-4);
	}

	.meta-chip {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		font-family: var(--font-mono);
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-text-secondary);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		padding: 3px 10px 3px 7px;
		border-radius: 999px;
	}

	.chip-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background-color: var(--chip-color, #cfd1d4);
		flex-shrink: 0;
	}

	.meta-date {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		color: var(--color-muted);
	}

	.model-viewer {
		margin: 0 auto var(--spacing-10);
		border-radius: var(--radius-lg);
		overflow: hidden;
		border: 1px solid var(--color-border);
	}

	.model-description {
		max-width: var(--content-width);
		margin: 0 auto var(--spacing-12);
		font-family: var(--font-serif), Georgia, serif;
		font-size: var(--font-size-lg);
		line-height: 1.8;
		color: var(--color-text);
	}

	.model-description :global(p) {
		margin-bottom: 1.5em;
	}

	.model-description :global(h2) {
		font-family: var(--font-serif);
		font-size: var(--font-size-2xl);
		font-weight: 400;
		margin-top: 2.5em;
		margin-bottom: 0.75em;
	}

	.model-description :global(a) {
		color: var(--color-accent);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.related-posts {
		border-top: 1px solid var(--color-border);
		padding-top: var(--spacing-10);
	}

	.related-title {
		font-family: var(--font-serif) !important;
		font-size: var(--font-size-2xl);
		font-weight: 400 !important;
		margin-bottom: var(--spacing-6);
	}

	.related-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.25rem;
	}

	@media (max-width: 900px) {
		.related-grid { grid-template-columns: repeat(2, 1fr); }
	}

	@media (max-width: 600px) {
		.model-page { padding: 2rem var(--spacing-4) var(--spacing-12); }
		.model-title { font-size: var(--font-size-3xl); }
		.related-grid { grid-template-columns: 1fr; }
	}
</style>
