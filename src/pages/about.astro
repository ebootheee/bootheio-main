---
import Base from "../layouts/Base.astro";
import { investments as investmentData } from "../data/investments";

export const prerender = true;

// Wrap each record as { data } so the existing template (entry.data.*) is unchanged.
const investments = investmentData
	.slice()
	.sort((a, b) => a.sort_order - b.sort_order)
	.map((data) => ({ data }));
---

<Base
	title="About"
	description="Eric Boothe — engineer, writer, and investor. A portfolio of companies I've backed."
	type="website"
>
	<!-- ============== HERO ============== -->
	<section class="ab-hero">
		<div class="ab-hero-inner">
			<p class="ab-status">
				<span class="ab-status-dot"></span>
				ABOUT &nbsp;//&nbsp; <span>eric boothe</span>
			</p>

			<h1 class="ab-title">
				Engineer. Writer. <span class="ab-title-italic">Investor.</span>
			</h1>

			<p class="ab-tagline">
				A longer bio is on its way. In the meantime, the easiest shorthand is
				the list of companies below — early-stage software bets in places where
				physical and financial reality still bites: construction, energy, real
				estate, industrial infrastructure.
			</p>

			<div class="ab-cta-row">
				<a href="#portfolio" class="ab-btn ab-btn-primary">
					<span class="ab-btn-arrow">▾</span> See the portfolio
				</a>
				<a href="/posts" class="ab-btn">
					Read the writing →
				</a>
				<a href="https://github.com/ebootheee" target="_blank" rel="noopener noreferrer" class="ab-btn ab-btn-ghost">
					GitHub →
				</a>
			</div>
		</div>
	</section>

	<!-- ============== PORTFOLIO ============== -->
	<section class="ab-section" id="portfolio">
		<div class="ab-section-inner">
			<div class="ab-section-head">
				<span class="ab-section-label">// portfolio</span>
				<h2 class="ab-section-title">Companies I've backed</h2>
				<p class="ab-section-sub">
					{investments.length} investments — software for industries where the
					ground truth is concrete, kilowatts, contractors, or rent checks.
				</p>
			</div>

			<ul class="ab-grid">
				{investments.map((entry) => (
					<li class="ab-card">
						<a class="ab-card-link" href={entry.data.url} target="_blank" rel="noopener noreferrer">
							<div class="ab-logo-frame">
								<img
									src={entry.data.logo}
									alt={`${entry.data.name} logo`}
									loading="lazy"
									width="80"
									height="80"
								/>
							</div>
							<div class="ab-card-body">
								<div class="ab-card-head">
									<h3 class="ab-card-name">{entry.data.name}</h3>
									{entry.data.acquired_by
										? <span class="ab-card-exit">acq. {entry.data.acquired_by}</span>
										: <span class="ab-card-arrow" aria-hidden="true">↗</span>
									}
								</div>
								<p class="ab-card-tagline">{entry.data.tagline}</p>
								<p class="ab-card-pitch">{entry.data.pitch}</p>
								<div class="ab-card-footer">
									<span class="ab-card-industry">{entry.data.industry}</span>
									{entry.data.co_investors && (
										<span class="ab-card-coinvestors">w/ {entry.data.co_investors}</span>
									)}
								</div>
							</div>
						</a>
					</li>
				))}
			</ul>
		</div>
	</section>

	<!-- ============== BIO PLACEHOLDER ============== -->
	<section class="ab-section ab-section-prose">
		<div class="ab-section-inner ab-narrow">
			<div class="ab-section-head">
				<span class="ab-section-label">// bio</span>
				<h2 class="ab-section-title">Coming soon</h2>
			</div>

			<p class="ab-prose">
				The proper bio — what I work on day-to-day, how I got here, what kinds
				of companies I write checks for — is being written. For now, the
				portfolio above is the most honest summary.
			</p>

			<p class="ab-prose">
				If you'd like to talk —
				<a href="mailto:eric@boothe.io">eric@boothe.io</a>.
			</p>
		</div>
	</section>
</Base>

<style>
	/* =========================================================
	   /about — bio & portfolio page. Tokens inherit from
	   theme.css; page-specific tokens are ab-* .
	   ========================================================= */

	.ab-hero {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: 5rem var(--spacing-6) 3rem;
		position: relative;
	}
	.ab-hero-inner { max-width: 820px; }

	.ab-status {
		font-family: var(--font-pixel);
		font-size: 0.875rem;
		color: var(--color-retro-muted);
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 1rem;
		letter-spacing: 0.04em;
	}
	.ab-status-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--color-success);
		animation: glow-pulse 3s ease-in-out infinite;
	}

	.ab-title {
		font-family: var(--font-serif) !important;
		font-size: 4.75rem;
		font-weight: 400 !important;
		line-height: 1.05;
		color: var(--color-text);
		margin-bottom: 1.5rem;
		letter-spacing: 0;
	}
	.ab-title-italic {
		font-style: italic;
		color: var(--color-accent);
	}

	.ab-tagline {
		font-family: var(--font-serif);
		font-size: 1.15rem;
		line-height: 1.6;
		color: var(--color-text-secondary);
		max-width: 720px;
		margin-bottom: 2rem;
	}

	.ab-cta-row {
		display: flex;
		gap: 0.75rem;
		flex-wrap: wrap;
		margin-bottom: 1rem;
	}

	.ab-btn {
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		padding: 0.65rem 1.1rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		color: var(--color-text);
		text-decoration: none;
		background: var(--color-panel);
		transition:
			border-color var(--transition-fast),
			background var(--transition-fast),
			color var(--transition-fast),
			transform var(--transition-fast);
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		letter-spacing: 0.01em;
	}
	.ab-btn:hover {
		border-color: var(--color-accent-border);
		background: var(--color-accent-soft);
		color: var(--color-accent-hover);
		transform: translateY(-1px);
	}
	.ab-btn-primary {
		background: var(--color-accent);
		color: var(--color-on-accent) !important;
		border-color: var(--color-accent);
		font-weight: 500;
	}
	.ab-btn-primary:hover {
		background: var(--color-accent-hover);
		border-color: var(--color-accent-hover);
		color: var(--color-on-accent) !important;
	}
	.ab-btn-ghost {
		background: transparent;
		color: var(--color-muted);
	}
	.ab-btn-ghost:hover { color: var(--color-text); }
	.ab-btn-arrow {
		display: inline-block;
		font-size: 0.7rem;
		opacity: 0.7;
	}

	/* ---- Sections -------------------------------------------------------- */

	.ab-section {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: 3rem var(--spacing-6) 3rem;
	}
	.ab-section-inner { max-width: 100%; }
	.ab-narrow { max-width: 680px; margin: 0 auto; }

	.ab-section-head { margin-bottom: 2rem; }
	.ab-section-label {
		display: block;
		font-family: var(--font-pixel);
		font-size: 0.7rem;
		color: var(--color-retro-muted);
		text-transform: uppercase;
		letter-spacing: 0.18em;
		margin-bottom: 0.4rem;
	}
	.ab-section-title {
		font-family: var(--font-serif) !important;
		font-size: 2.25rem;
		font-weight: 400 !important;
		color: var(--color-text);
		line-height: 1.15;
	}
	.ab-section-sub {
		font-family: var(--font-serif);
		font-size: 1rem;
		line-height: 1.6;
		color: var(--color-text-secondary);
		max-width: 620px;
		margin-top: 0.6rem;
	}

	.ab-prose {
		font-family: var(--font-serif);
		font-size: 1.05rem;
		line-height: 1.75;
		color: var(--color-text-secondary);
		max-width: 680px;
		margin-bottom: 1.25rem;
	}
	.ab-prose a {
		color: var(--color-accent);
		text-decoration: none;
		border-bottom: 1px solid var(--color-accent-border);
		transition: border-color var(--transition-fast), color var(--transition-fast);
	}
	.ab-prose a:hover {
		color: var(--color-accent-hover);
		border-bottom-color: var(--color-accent-hover);
	}

	/* ---- Portfolio grid -------------------------------------------------- */

	.ab-grid {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
		gap: 1rem;
	}
	.ab-card {
		margin: 0;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		background: var(--color-panel);
		overflow: hidden;
		transition:
			border-color var(--transition-base),
			background var(--transition-base),
			transform var(--transition-base);
	}
	.ab-card:hover {
		border-color: var(--color-accent-border);
		background: var(--color-panel-hover);
		transform: translateY(-2px);
	}
	.ab-card-link {
		display: grid;
		grid-template-columns: 96px 1fr;
		gap: 1.1rem;
		padding: 1.1rem;
		text-decoration: none;
		color: inherit;
		align-items: start;
	}

	.ab-logo-frame {
		width: 96px;
		height: 96px;
		border-radius: var(--radius);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
		flex-shrink: 0;
	}
	.ab-logo-frame img {
		max-width: 100%;
		max-height: 100%;
		width: auto;
		height: auto;
		display: block;
		object-fit: contain;
	}

	.ab-card-body {
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}
	.ab-card-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.5rem;
	}
	.ab-card-name {
		font-family: var(--font-serif) !important;
		font-size: 1.25rem;
		font-weight: 400 !important;
		color: var(--color-text);
		margin: 0;
		line-height: 1.2;
	}
	.ab-card-arrow {
		font-family: var(--font-mono);
		font-size: 0.85rem;
		color: var(--color-muted);
		transition: color var(--transition-fast), transform var(--transition-fast);
	}
	.ab-card:hover .ab-card-arrow {
		color: var(--color-accent);
		transform: translate(2px, -2px);
	}
	.ab-card-tagline {
		font-family: var(--font-serif);
		font-style: italic;
		font-size: 0.92rem;
		line-height: 1.4;
		color: var(--color-accent);
		margin: 0;
	}
	.ab-card-pitch {
		font-family: var(--font-serif);
		font-size: 0.92rem;
		line-height: 1.55;
		color: var(--color-text-secondary);
		margin: 0;
	}
	.ab-card-footer {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.5rem;
		margin-top: 0.25rem;
	}
	.ab-card-industry {
		font-family: var(--font-pixel);
		font-size: 0.7rem;
		color: var(--color-retro-muted);
		text-transform: uppercase;
		letter-spacing: 0.12em;
	}
	.ab-card-coinvestors {
		font-family: var(--font-mono);
		font-size: 0.68rem;
		color: var(--color-muted);
		letter-spacing: 0.01em;
	}
	.ab-card-exit {
		font-family: var(--font-pixel);
		font-size: 0.65rem;
		color: var(--color-success);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		border: 1px solid var(--color-success);
		border-radius: var(--radius);
		padding: 0.15em 0.45em;
		line-height: 1.4;
		opacity: 0.85;
	}

	/* ---- Responsive ------------------------------------------------------ */

	@media (max-width: 720px) {
		.ab-hero { padding: 3rem var(--spacing-4) 2rem; }
		.ab-title { font-size: 3rem; }
		.ab-tagline { font-size: 1.05rem; }
		.ab-section-title { font-size: var(--font-size-3xl); }
		.ab-section { padding: 2.5rem var(--spacing-4) 2rem; }
		.ab-grid { grid-template-columns: 1fr; }
		.ab-card-link {
			grid-template-columns: 72px 1fr;
			gap: 0.85rem;
			padding: 0.9rem;
		}
		.ab-logo-frame {
			width: 72px;
			height: 72px;
		}
	}
</style>
