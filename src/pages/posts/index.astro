---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import { getReadingTime } from "../../utils/reading-time";

export const prerender = true;

const posts = await getCollection("posts", (p) => !p.data.draft);

const sortedPosts = posts.toSorted((a, b) => {
	const dateA = a.data.publishedAt?.getTime() ?? 0;
	const dateB = b.data.publishedAt?.getTime() ?? 0;
	return dateB - dateA;
});

const postsWithTags = sortedPosts.map((post) => ({
	post,
	tags: (post.data.tags ?? []).map((t) => ({ slug: t, label: t })),
	bylines: [] as any[],
}));
---

<Base title="Blog" description="All blog posts">
	<div class="posts-page">
		<div class="page-header">
			<div class="breadcrumb">
				<a href="/">home</a>
				<span>/</span>
				<span class="current">blog</span>
			</div>
			<h1 class="page-title">Blog</h1>
			<p class="page-count">
				{posts.length} posts — sorted newest first
			</p>
			<div class="page-divider"></div>
		</div>

		{sortedPosts.length === 0 ? (
			<p class="empty">No posts yet.</p>
		) : (
			<div class="posts-grid">
				{postsWithTags.map(({ post, tags, bylines }) => (
					<PostCard
						title={post.data.title ?? "Untitled"}
						excerpt={post.data.excerpt}
						href={`/posts/${post.id}`}
						date={post.data.publishedAt ?? undefined}
						readingTime={getReadingTime(post.body)}
						tags={tags}
						bylines={bylines}
					/>
				))}
			</div>
		)}
	</div>
</Base>

<style>
	.posts-page {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: 4rem var(--spacing-6);
	}

	.page-header {
		margin-bottom: 3rem;
	}

	.breadcrumb {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--color-muted);
		margin-bottom: 1rem;
	}

	.breadcrumb a {
		color: var(--color-muted);
		text-decoration: none;
		transition: color 0.2s;
	}

	.breadcrumb a:hover {
		color: var(--color-accent);
	}

	.breadcrumb .current {
		color: var(--color-text-secondary);
	}

	.page-title {
		font-family: var(--font-serif) !important;
		font-size: var(--font-size-4xl);
		font-weight: 400 !important;
		color: var(--color-text);
	}

	.page-count {
		margin-top: 0.75rem;
		font-size: 0.875rem;
		color: var(--color-muted);
	}

	.page-divider {
		margin-top: 1.5rem;
		height: 1px;
		background: var(--gradient-rule);
	}

	.posts-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.25rem;
	}

	.empty {
		color: var(--color-muted);
		font-size: var(--font-size-lg);
	}

	@media (max-width: 900px) {
		.posts-grid { grid-template-columns: repeat(2, 1fr); }
	}

	@media (max-width: 600px) {
		.posts-page { padding: 2.5rem var(--spacing-4); }
		.page-title { font-size: var(--font-size-3xl); }
		.posts-grid { grid-template-columns: 1fr; }
	}
</style>
